#!/usr/bin/env python3
"""Factory CI status: fetches GitHub Actions / GitLab CI state per factory job + repo-wide.

  .factory/ci                  refresh stale jobs (TTL 30s) and print summary
  .factory/ci --once --ttl 0   force refresh all pr-open jobs, print JSON lines
  .factory/ci <job-id>         refresh + show that job's pipeline stages/jobs
  .factory/ci --others         also list recent pipelines outside factory/* branches
  .factory/ci --quiet          refresh, print nothing (for .factory/watch loop)
  .factory/ci wait <job-id> [--timeout S]
                               block until the pipeline/checks of the job's current head SHA finish;
                               print one line `CI: SUCCESS|FAILED|INFRA|MERGED|CLOSED|TIMEOUT <job> …`;
                               exit 0 on SUCCESS/MERGED, else 1. Start it as a background command so
                               the harness wakes the session when CI is done (never a polling loop).

Cache: .factory/cache/ci-<job-id>.json + ci-others.json, so `watch` never blocks on
the API. Forge comes from .factory/config.json (`github` | `gitlab`).

Also a library for `.factory/precheck --validate` in `validate.mode: ci`: `head_pipeline()` (the
pipeline of one pushed commit, through its PR/MR or the branch) and `failed_logs()` (the tail
of each failing job's log).

Infrastructure failures: a failed job whose log shows OOMKilled, `exit code 137`, `ERROR: Job
failed (system failure)`, a runner or scheduler error, or a registry (Harbor) push error with no
failing test in the log, is INFRA, not a code failure (`infra_reason()`). The refresh retries such
a pipeline once by itself (GitLab: `POST jobs/:id/retry`; GitHub: `gh run rerun <run> --failed`)
and reports `CI: INFRA (<reason>), retried`; `precheck --validate` does the same and never turns
it into a rework round.

A PR/MR the forge shows merged or closed while the job still says otherwise: the refresh runs
`.factory/job prs <job-id>` at once (it marks the job merged and closes its issues, or reports the
closed PR/MR), so a merge outside the factory is never stale until the next `/factory status`.

Preview cleanup (config `ci.preview_cleanup_job`, e.g. `kubernetes:deploy-preview:cleanup`): a failed
preview deploy (a job matching `ci.preview_jobs`, default `*preview*`, whose log shows a Helm upgrade
failure, a failed pre-upgrade hook or `timed out waiting for the condition`) is INFRA; before its one
retry the cleanup job of the same pipeline is played (manual) or retried and waited for, so the
deploy starts on a fresh preview namespace. Without the key nothing changes.

Requires: `gh` (github) or `glab` (gitlab) logged in. Missing CLI/auth -> cached
state is kept and the error is reported once, never crashes watch.
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse

HERE = os.path.dirname(os.path.abspath(__file__))  # <repo>/.factory
CACHE = os.path.join(HERE, "cache")
TTL_DEFAULT = 30
CLI_TIMEOUT = 15


def load_config():
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def load_jobs():
    jobs_dir = os.path.join(HERE, "jobs")
    jobs = []
    if not os.path.isdir(jobs_dir):
        return jobs
    for name in sorted(os.listdir(jobs_dir)):
        p = os.path.join(jobs_dir, name, "job.json")
        try:
            with open(p) as f:
                j = json.load(f)
        except (OSError, ValueError):
            continue
        j.setdefault("id", name)
        jobs.append(j)
    return jobs


def run(cmd, cwd=None, raw=False):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=CLI_TIMEOUT, cwd=cwd)
    except FileNotFoundError:
        return None, "command not found: " + cmd[0]
    except subprocess.TimeoutExpired:
        return None, "timeout: " + " ".join(cmd[:4])
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "").strip().splitlines()
        return None, "; ".join(err[-2:]) if err else f"exit {r.returncode}"
    if raw:
        return r.stdout, None
    try:
        return json.loads(r.stdout) if r.stdout.strip() else {}, None
    except ValueError:
        return r.stdout, None


def cache_path(job_id):
    os.makedirs(CACHE, exist_ok=True)
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", job_id)
    return os.path.join(CACHE, f"ci-{safe}.json")


def cache_fresh(path, ttl):
    try:
        age = time.time() - os.path.getmtime(path)
        return age < ttl
    except OSError:
        return False


def read_cache(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_cache(path, data):
    os.makedirs(CACHE, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


# ---------- GitHub ----------

def gh_pr_number(pr_url):
    m = re.search(r"/pull/(\d+)", pr_url or "")
    return m.group(1) if m else None


def gh_repo(pr_url):
    """OWNER/REPO from a PR URL, so gh asks the repo the PR is in, not its default repo."""
    m = re.search(r"github\.com/([^/]+/[^/]+)/pull/", pr_url or "")
    return m.group(1) if m else None


def gh_check(c):
    """Status of one statusCheckRollup entry: a CheckRun (status + conclusion) or a
    StatusContext (state), e.g. SonarCloud."""
    if c.get("__typename") == "StatusContext" or ("state" in c and "status" not in c):
        return {"SUCCESS": "success", "FAILURE": "failed", "ERROR": "failed",
                "PENDING": "pending", "EXPECTED": "pending"}.get((c.get("state") or "").upper(), "unknown")
    return normalize_gh_run(c.get("status"), c.get("conclusion"))


def fetch_github(job, deep=True):
    """Returns dict {pipeline, merge, jobs:[{name,stage,status,url}], error}."""
    pr_url = job.get("pr_url") or ""
    num = gh_pr_number(pr_url)
    branch = job.get("branch") or ""
    if not num:
        return {"error": "no pr_url with /pull/<n> in job.json"}
    repo = gh_repo(pr_url)
    pr, err = run(["gh", "pr", "view", pr_url if repo else num, "--json",
                   "number,state,mergeStateStatus,headRefName,statusCheckRollup"])
    if err:
        return {"error": err}
    rollup = pr.get("statusCheckRollup") or []
    jobs = []
    for c in rollup:
        jobs.append({"name": c.get("name") or c.get("context") or "?", "stage": "",
                     "status": gh_check(c), "url": c.get("detailsUrl") or c.get("targetUrl") or ""})
    pipeline = overall(jobs) if rollup else "none"
    merge = str(pr.get("mergeStateStatus") or "UNKNOWN").lower()
    if str(pr.get("state") or "").upper() in ("MERGED", "CLOSED"):
        merge = str(pr["state"]).lower()  # mergeStateStatus is UNKNOWN once the PR is no longer open
    out = {"forge": "github", "pipeline": pipeline, "merge": merge,
           "pr_state": pr.get("state"), "jobs": jobs, "url": pr_url,
           "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    # Deep: per-step jobs of the latest run on this branch (gh run view --json jobs)
    if deep and branch:
        rflag = ["-R", repo] if repo else []
        runs, rerr = run(["gh", "run", "list", *rflag, "--branch", branch, "--limit", "1",
                          "--json", "databaseId,status,conclusion,url,createdAt"])
        if not rerr and runs:
            rid = str(runs[0].get("databaseId"))
            det, derr = run(["gh", "run", "view", *rflag, rid, "--json", "jobs"])
            if not derr and isinstance(det, dict) and det.get("jobs"):
                djobs = []
                for jb in det["jobs"]:
                    st = normalize_gh_run(jb.get("status"), jb.get("conclusion"))
                    djobs.append({"name": jb.get("name", "?"), "stage": "",
                                  "status": st, "url": runs[0].get("url", "")})
                if djobs:
                    # Add the latest run's jobs to the rollup, never replace it: other
                    # workflows and commit statuses (Sonar) must stay visible.
                    seen = {j["name"] for j in djobs}
                    out["jobs"] = djobs + [j for j in jobs if j["name"] not in seen]
                    out["run_url"] = runs[0].get("url")
                    out["pipeline"] = overall(out["jobs"])
    return out


def normalize_gh_run(status, conclusion):
    s, c = (status or "").upper(), (conclusion or "").upper()
    if s == "COMPLETED" or (c and not s):
        return {"SUCCESS": "success", "NEUTRAL": "success", "FAILURE": "failed",
                "TIMED_OUT": "failed", "STARTUP_FAILURE": "failed", "ACTION_REQUIRED": "failed",
                "CANCELLED": "canceled", "SKIPPED": "skipped", "STALE": "skipped"}.get(c, "unknown")
    if s == "IN_PROGRESS":
        return "running"
    return "pending"


def overall(jobs):
    if any(j["status"] == "failed" for j in jobs):
        return "failed"
    if any(j["status"] in ("running", "pending", "unknown") for j in jobs):
        return "running"
    return "success"


def fetch_github_others(limit=5):
    runs, err = run(["gh", "run", "list", "--limit", str(limit),
                     "--json", "name,headBranch,status,conclusion,url,createdAt"])
    if err:
        return {"error": err}
    items = []
    for r in runs or []:
        if (r.get("headBranch") or "").startswith("factory/"):
            continue
        items.append({"branch": r.get("headBranch"), "name": r.get("name"),
                      "status": normalize_gh_run(r.get("status"), r.get("conclusion")),
                      "url": r.get("url"), "at": r.get("createdAt")})
        if len(items) >= limit:
            break
    return {"pipelines": items, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}


# ---------- GitLab ----------

def remote_project_path(url):
    """group/sub/project from a remote URL: https://host/g/p.git, ssh://git@host:2222/g/p.git,
    git@host:g/p.git. None if it does not look like one."""
    url = (url or "").strip()
    if "://" in url:
        path = urllib.parse.urlparse(url).path
    elif re.match(r"^[^/]+@[^/:]+:", url) or re.match(r"^[^/:]+:[^/]", url):
        path = url.split(":", 1)[1]  # scp-like syntax
    else:
        return None
    path = path.strip("/")
    path = path[:-4] if path.endswith(".git") else path
    return path if "/" in path else None


def gitlab_project_path():
    remote = (load_config().get("delivery") or {}).get("remote") or "origin"
    r = subprocess.run(["git", "remote", "get-url", remote],
                       capture_output=True, text=True, cwd=os.path.dirname(HERE))
    return remote_project_path(r.stdout)


def gitlab_project_id():
    """Project id for the remote's path; cached (it never changes for a path)."""
    path = gitlab_project_path()
    if not path:
        return None, "no remote to derive the project path from"
    cpath = os.path.join(CACHE, "ci-gitlab-project.json")
    known = read_cache(cpath) or {}
    if known.get("path") == path and known.get("id"):
        return known["id"], None
    enc = urllib.parse.quote(path, safe="")
    proj, err = run(["glab", "api", f"projects/{enc}"])
    if err:
        return None, err
    pid = proj.get("id") if isinstance(proj, dict) else None
    if pid:
        try:
            write_cache(cpath, {"path": path, "id": pid})
        except OSError:
            pass
    return pid, None if pid else "project not found"


def glab_mr_iid(pr_url):
    m = re.search(r"/merge_requests/(\d+)", pr_url or "")
    return m.group(1) if m else None


def normalize_gl(status):
    return {"success": "success", "failed": "failed", "running": "running",
            "pending": "pending", "canceled": "canceled", "skipped": "skipped",
            "manual": "manual", "created": "pending"}.get((status or "").lower(), status or "unknown")


def fetch_gitlab(job, pid=None):
    pr_url = job.get("pr_url") or ""
    iid = glab_mr_iid(pr_url)
    if not iid:
        return {"error": "no pr_url with /merge_requests/<iid> in job.json"}
    pid = pid or gitlab_project_id()[0]
    if not pid:
        _, err = gitlab_project_id()
        return {"error": err or "unknown project"}
    mr, err = run(["glab", "api", f"projects/{pid}/merge_requests/{iid}"])
    if err:
        return {"error": err}
    pipe = mr.get("head_pipeline") or {}
    pid_pipe = pipe.get("id")
    pipeline = normalize_gl(pipe.get("status")) if pipe else "none"
    merge = mr.get("detailed_merge_status") or "unknown"
    if mr.get("state") in ("merged", "closed"):
        merge = mr["state"]
    jobs = []
    if pid_pipe:
        js, jerr = run(["glab", "api", f"projects/{pid}/pipelines/{pid_pipe}/jobs?per_page=100"])
        if not jerr and isinstance(js, list):
            for jb in js:
                jobs.append({"name": jb.get("name", "?"), "stage": jb.get("stage", ""),
                             "status": normalize_gl(jb.get("status")), "id": jb.get("id"),
                             "url": jb.get("web_url", ""), "failure_reason": jb.get("failure_reason")})
    return {"forge": "gitlab", "pipeline": pipeline, "merge": str(merge).lower(),
            "mr_state": mr.get("state"), "jobs": jobs, "url": pr_url,
            "pipeline_id": pid_pipe, "pipeline_sha": pipe.get("sha"), "pipeline_url": pipe.get("web_url"),
            "pipeline_created": pipe.get("created_at"),
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}


def fetch_gitlab_others(pid, limit=5):
    pipes, err = run(["glab", "api", f"projects/{pid}/pipelines?per_page={limit}&order_by=updated_at"])
    if err:
        return {"error": err}
    items = []
    for p in pipes or []:
        ref = p.get("ref", "")
        if ref.startswith("factory/"):
            continue
        items.append({"branch": ref, "name": f"pipeline #{p.get('id')}",
                      "status": normalize_gl(p.get("status")),
                      "url": p.get("web_url"), "at": p.get("updated_at")})
        if len(items) >= limit:
            break
    return {"pipelines": items, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}


# ---------- one pushed commit (precheck --validate in validate.mode ci) ----------

REPO = os.path.dirname(HERE)
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def gh_commit(sha):
    """Check runs + commit statuses of one commit: the PR's checks and the push workflows alike."""
    runs, err = run(["gh", "api", f"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?per_page=100"], cwd=REPO)
    if err:
        return {"error": err}
    jobs = []
    for c in (runs or {}).get("check_runs") or []:
        url = c.get("details_url") or c.get("html_url") or ""
        jobs.append({"name": c.get("name") or "?", "stage": "", "url": url, "id": c.get("id"),
                     "status": normalize_gh_run(c.get("status"), c.get("conclusion"))})
    st, err = run(["gh", "api", f"repos/{{owner}}/{{repo}}/commits/{sha}/status"], cwd=REPO)
    for c in ((st or {}).get("statuses") or []) if not err else []:
        jobs.append({"name": c.get("context") or "?", "stage": "", "url": c.get("target_url") or "",
                     "status": gh_check({"__typename": "StatusContext", "state": c.get("state")})})
    return {"pipeline": overall(jobs) if jobs else "none", "jobs": jobs, "url": None}


def gl_pipeline_jobs(pid, pipe_id):
    js, err = run(["glab", "api", f"projects/{pid}/pipelines/{pipe_id}/jobs?per_page=100"], cwd=REPO)
    return [{"name": jb.get("name", "?"), "stage": jb.get("stage", ""), "id": jb.get("id"),
             "status": normalize_gl(jb.get("status")), "url": jb.get("web_url", ""),
             "failure_reason": jb.get("failure_reason")}
            for jb in (js if not err and isinstance(js, list) else [])]


def ts_epoch(s):
    """Epoch seconds of an ISO time with `Z`, an offset (`+01:00`) or fractions; None when unreadable."""
    import datetime
    try:
        d = datetime.datetime.fromisoformat(str(s).strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return (d if d.tzinfo else d.replace(tzinfo=datetime.timezone.utc)).timestamp()


def head_pipeline(forge, branch, sha, pr_url=None, since=None):
    """The CI state of commit `sha` on `branch`: {pipeline: none|pending|running|success|failed|
    canceled|manual|skipped, jobs: [{name, stage, status, url, id}], url} or {error}. With a GitLab MR
    its head pipeline counts when it is for `sha` or was created after `since` (ISO time of the push:
    a merged-results pipeline runs on a merge commit, not on `sha`)."""
    if forge == "github":
        return gh_commit(sha)
    if forge != "gitlab":
        return {"error": f"unknown forge '{forge}' (config.json)"}
    if pr_url:
        mr = fetch_gitlab({"pr_url": pr_url}, pid=":id")
        if mr.get("error"):
            return mr
        made, floor = ts_epoch(mr.get("pipeline_created")), ts_epoch(since)
        fresh = mr.get("pipeline_sha") == sha or (made is not None and floor is not None and made >= floor)
        if mr.get("pipeline") != "none" and fresh:
            return {"pipeline": mr["pipeline"], "jobs": mr.get("jobs") or [], "url": mr.get("pipeline_url")}
        return {"pipeline": "none", "jobs": [], "url": None}
    ref = urllib.parse.quote(branch, safe="")
    pipes, err = run(["glab", "api", f"projects/:id/pipelines?sha={sha}&ref={ref}&per_page=5"], cwd=REPO)
    if err:
        return {"error": err}
    if not pipes:
        return {"pipeline": "none", "jobs": [], "url": None}
    p = pipes[0]
    return {"pipeline": normalize_gl(p.get("status")), "jobs": gl_pipeline_jobs(":id", p.get("id")),
            "url": p.get("web_url")}


def failed_logs(forge, jobs, lines=40):
    """{job name: the last `lines` lines of its log} for the failed jobs (best effort)."""
    out = {}
    for jb in [j for j in jobs if j.get("status") == "failed"][:5]:
        text = None
        if forge == "github":
            m = re.search(r"/job/(\d+)", jb.get("url") or "")
            jid = m.group(1) if m else jb.get("id")
            if jid:
                text, _ = run(["gh", "run", "view", "--job", str(jid), "--log-failed"], cwd=REPO, raw=True)
        elif forge == "gitlab":
            m = re.search(r"/-/jobs/(\d+)", jb.get("url") or "")
            jid = m.group(1) if m else jb.get("id")
            if jid:
                text, _ = run(["glab", "api", f"projects/:id/jobs/{jid}/trace"], cwd=REPO, raw=True)
        tail = ANSI.sub("", text or "").rstrip().splitlines()[-lines:]
        out[jb["name"]] = "\n".join(tail) if tail else "(no log available through the forge)"
    return out


# ---------- infrastructure failures: classify, retry once ----------

# (pattern, reason). Matched against the ANSI-free tail of a failed job's log.
INFRA_PATTERNS = [
    (re.compile(r"\bOOMKilled\b"), "OOMKilled"),
    (re.compile(r"exit(?:ed with)? code:? ?137\b|\bexit status 137\b", re.I), "exit code 137"),
    (re.compile(r"ERROR: Job failed \(system failure\)", re.I), "runner system failure"),
    (re.compile(r"runner[ _]system[ _]failure", re.I), "runner system failure"),
    (re.compile(r"scheduler[ _]failure|\bfailed to schedule\b|\bFailedScheduling\b|\bUnschedulable\b", re.I),
     "scheduler failure"),
    (re.compile(r"stuck_or_timeout_failure|This job is stuck because", re.I), "no runner picked the job up"),
    (re.compile(r"runner has received a shutdown signal|lost communication with the server|"
                r"The hosted runner encountered an error", re.I), "runner lost"),
    (re.compile(r"\bNo space left on device\b", re.I), "runner out of disk"),
    (re.compile(r"timed out waiting for the condition", re.I), "deploy environment timed out"),
]
# A registry/Harbor error counts only when no test failed in the same log (a push after the tests).
REGISTRY_PATTERNS = re.compile(
    r"quota exceeded|exceeded (?:the )?(?:storage )?quota|storage quota|"
    r"error pushing|failed to push|push access denied|denied: requested access to the resource is denied|"
    r"unauthorized: authentication required|toomanyrequests|blob upload (?:unknown|invalid)|"
    r"received unexpected HTTP status: 5\d\d|error parsing HTTP 5\d\d|"
    r"(?:cr\.surf\.nl|harbor)\S*.*\b(?:denied|unauthorized|error|failed)\b", re.I)
TEST_FAILED = re.compile(r"\b[1-9]\d* (?:failed|errors?)\b|^FAILED\b|^E {3}|^\s*Tests?:.*\b[1-9]\d* failed|"
                         r"npm ERR! Test failed|^--- FAIL\b|test result: FAILED", re.I | re.M)
# GitLab's own failure_reason values that never come from the code
GL_INFRA_REASONS = {"runner_system_failure": "runner system failure", "scheduler_failure": "scheduler failure",
                    "stuck_or_timeout_failure": "no runner picked the job up", "api_failure": "GitLab API failure",
                    "runner_unsupported": "runner unsupported", "data_integrity_failure": "GitLab data integrity failure"}


def log_infra_reason(text):
    """The infrastructure reason a job log shows, or None when it looks like a code failure."""
    text = ANSI.sub("", text or "")
    if not text.strip():
        return None
    failed_tests = TEST_FAILED.search(text)
    for rx, why in INFRA_PATTERNS:
        if rx.search(text) and not failed_tests:
            return why
    m = REGISTRY_PATTERNS.search(text)
    if m and not failed_tests:
        return "registry push error (" + m.group(0).strip()[:60] + ")"
    return None


# A preview deploy that failed on the state of an old preview namespace (prompt-library !706: the Helm
# pre-upgrade migrate Job in a 16 h old namespace). Only with config ci.preview_cleanup_job.
PREVIEW_PATTERNS = [
    (re.compile(r"pre-upgrade hooks? failed|failed pre-upgrade|pre-upgrade hook\S* .*\bfailed\b|"
                r"job failed: BackoffLimitExceeded", re.I), "pre-upgrade hook job failed"),
    (re.compile(r"UPGRADE FAILED|helm upgrade\b.*\bfailed\b|another operation \(install/upgrade/rollback\) is in progress",
                re.I), "Helm upgrade failed"),
    (re.compile(r"timed out waiting for the condition", re.I), "timed out waiting for the condition"),
]


def preview_config():
    """(cleanup job name, [globs of preview jobs]) from config.json `ci`, or None when not set."""
    c = load_config().get("ci")
    name = c.get("preview_cleanup_job") if isinstance(c, dict) else None
    if not isinstance(name, str) or not name.strip():
        return None
    globs = c.get("preview_jobs") or ["*preview*"]
    return name.strip(), [g for g in ([globs] if isinstance(globs, str) else globs) if isinstance(g, str)]


def preview_reason(job, text):
    """`preview deploy failed (<why>)` when ci.preview_cleanup_job is set, the job's name matches
    ci.preview_jobs (never the cleanup job itself) and its log shows a preview deploy failure."""
    import fnmatch
    pc = preview_config()
    name = str((job or {}).get("name") or "")
    if not pc or name == pc[0] or not any(fnmatch.fnmatchcase(name, g) for g in pc[1]):
        return None
    text = ANSI.sub("", text or "")   # no test-failure check: a deploy job runs no tests ("1 error occurred" is Helm's)
    for rx, why in PREVIEW_PATTERNS:
        if rx.search(text):
            return f"preview deploy failed ({why})"
    return None


def infra_reason(jobs, logs):
    """`<reason>` when EVERY failed job of a pipeline failed on infrastructure (its GitLab
    failure_reason, a preview deploy failure (preview_reason) or its log, see log_infra_reason),
    else None: one code failure is enough to make the whole pipeline a code failure."""
    failed = [j for j in jobs if j.get("status") == "failed"]
    if not failed:
        return None
    whys = []
    for j in failed:
        why = GL_INFRA_REASONS.get(str(j.get("failure_reason") or "")) or \
            preview_reason(j, logs.get(j.get("name"))) or log_infra_reason(logs.get(j.get("name")))
        if not why:
            return None
        whys.append(why)
    return ", ".join(dict.fromkeys(whys))


def job_key(j):
    """A failed job's identity (its id, or its URL): a retry makes a new job, so a new key."""
    return str(j.get("id") or j.get("url") or j.get("name"))


def retry_failed(forge, jobs, repo_flag=None):
    """Retry the failed jobs once: GitLab `POST jobs/:id/retry` per job, GitHub `gh run rerun <run>
    --failed` per run. Returns (retried keys, error or None)."""
    failed = [j for j in jobs if j.get("status") == "failed"]
    done, errs = [], []
    if forge == "gitlab":
        for j in failed:
            m = re.search(r"/-/jobs/(\d+)", j.get("url") or "")
            jid = m.group(1) if m else j.get("id")
            if not jid:
                errs.append(f"{j.get('name')}: no job id")
                continue
            _, err = run(["glab", "api", "-X", "POST", f"projects/:id/jobs/{jid}/retry"], cwd=REPO)
            (errs.append(f"{j.get('name')}: {err}") if err else done.append(job_key(j)))
    elif forge == "github":
        runs = {}
        for j in failed:
            m = re.search(r"/actions/runs/(\d+)", j.get("url") or "")
            if m:
                runs.setdefault(m.group(1), []).append(j)
            else:
                errs.append(f"{j.get('name')}: not a GitHub Actions run (cannot rerun it)")
        for rid, js in runs.items():
            _, err = run(["gh", "run", "rerun", rid, "--failed", *(repo_flag or [])], cwd=REPO)
            (errs.append(f"run {rid}: {err}") if err else done.extend(job_key(j) for j in js))
    else:
        errs.append(f"unknown forge '{forge}'")
    return done, ("; ".join(errs) or None)


def gl_job_id(j):
    m = re.search(r"/-/jobs/(\d+)", j.get("url") or "")
    return m.group(1) if m else (str(j["id"]) if j.get("id") else None)


def preview_cleanup(forge, all_jobs):
    """Play (manual) or retry the pipeline's ci.preview_cleanup_job and wait until it finishes
    (FACTORY_CI_CLEANUP_WAIT seconds, default 420). Returns a note for the report line."""
    pc = preview_config()
    if not pc:
        return None
    if forge != "gitlab":
        return f"preview cleanup {pc[0]}: only on GitLab, not run"
    job = next((j for j in all_jobs or [] if j.get("name") == pc[0]), None)
    jid = gl_job_id(job) if job else None
    if not jid:
        return f"preview cleanup {pc[0]}: not in this pipeline, not run"
    if job.get("status") in ("running", "pending"):
        new = {"id": jid}
    else:
        verb = "play" if job.get("status") in ("manual", "created") else "retry"
        new, err = run(["glab", "api", "-X", "POST", f"projects/:id/jobs/{jid}/{verb}"], cwd=REPO)
        if err or not isinstance(new, dict):
            return f"preview cleanup {pc[0]}: {verb} failed ({err or 'no job'})"
    nid = str(new.get("id") or jid)
    try:
        limit = float(os.environ.get("FACTORY_CI_CLEANUP_WAIT", "420"))
        poll = float(os.environ.get("FACTORY_CI_POLL", "15"))
    except ValueError:
        limit, poll = 420.0, 15.0
    end, st = time.time() + limit, None
    while True:
        cur, err = run(["glab", "api", f"projects/:id/jobs/{nid}"], cwd=REPO)
        st = normalize_gl((cur or {}).get("status")) if not err and isinstance(cur, dict) else None
        if st in ("success", "failed", "canceled", "skipped"):
            break
        if time.time() + poll > end:
            return f"preview cleanup {pc[0]} still {st or 'unknown'} after {int(limit)}s"
        time.sleep(max(poll, 0))
    return f"preview cleanup {pc[0]}: {st}"


def retry_infra(forge, failed, all_jobs=None, repo_flag=None, logs=None):
    """retry_failed, with the preview cleanup first when a failed job is a preview deploy failure
    (preview_reason on its log). Returns (retried keys, error or None, cleanup note or None)."""
    note = None
    failed = [j for j in failed if j.get("status") == "failed"]
    if preview_config() and logs is None:
        logs = failed_logs(forge, failed)
    if preview_config() and any(preview_reason(j, (logs or {}).get(j.get("name"))) for j in failed):
        note = preview_cleanup(forge, all_jobs or failed)
    done, err = retry_failed(forge, failed, repo_flag)
    return done, err, note


def infra_check(forge, data, old, repo_flag=None):
    """For a failed pipeline of a pr-open job: classify it once (logs of the failed jobs) and retry an
    infrastructure failure once. Sets data["infra"] = {reason, retried, keys, error?} and returns the
    report line (`CI: INFRA (<reason>), retried`) or None. `old` is the previous cache entry: the
    classification of the same failed jobs is reused, never fetched again."""
    failed = [j for j in data.get("jobs") or [] if j.get("status") == "failed"]
    keys = sorted(job_key(j) for j in failed)
    prev = (old or {}).get("infra") or {}
    if data.get("pipeline") != "failed" or not failed:
        if prev.get("retried"):   # the retry is running (or passed): remember it, so it is never retried twice
            data["infra"] = dict(prev, state=data.get("pipeline"))
        return None
    if prev.get("keys") == keys:   # the same failed jobs as last time: nothing new to fetch
        data["infra"] = prev
        return prev.get("line")
    if prev.get("retried") and set(keys) & set(prev.get("retried_keys") or []):
        data["infra"] = prev   # the forge still lists the jobs the retry replaces
        return prev.get("line")
    logs = failed_logs(forge, failed)
    why = infra_reason(failed, logs)
    if not why:
        data["infra"] = {"keys": keys, "reason": None}
        return None
    if prev.get("retried"):
        line = f"CI: INFRA ({why}), failed again after one retry: not a code failure, a human looks"
        data["infra"] = {"keys": keys, "reason": why, "retried": prev["retried"], "line": line, "again": True}
        return line
    done, err, note = retry_infra(forge, failed, data.get("jobs"), repo_flag, logs)
    line = (f"CI: INFRA ({why}), " + (f"{note}, " if note else "")
            + ("retried" if done else f"retry failed: {err}"))
    data["infra"] = {"keys": keys, "reason": why, "retried": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) if done else None,
                     "retried_keys": done, "line": line, **({"error": err} if err else {})}
    return line


# ---------- main ----------

UNFINISHED = ("queued", "spec", "build", "review", "approve", "deliver", "needs-human")


def watched(job):
    """A pr-open job, or an unfinished one whose PR/MR is already open (validate.mode ci opens it
    before delivery): both have a pipeline to show."""
    return job.get("stage") == "pr-open" or (job.get("stage") in UNFINISHED and bool(job.get("pr_url")))


def refresh_job(job, forge, ttl, force, quiet, pid=None):
    if not watched(job):
        return None
    path = cache_path(job["id"])
    if not force and cache_fresh(path, ttl):
        return read_cache(path)
    old = read_cache(path)
    if forge == "gitlab":
        data = fetch_gitlab(job, pid)
    elif forge == "github":
        data = fetch_github(job)
    else:
        data = {"error": f"unknown forge '{forge}' (config.json)"}
    data["job"] = job["id"]
    if data.get("error"):
        if not quiet:
            print(f"{job['id']}: CI error: {data['error']}", file=sys.stderr)
        old = read_cache(path)
        if old:
            old["stale_error"] = data["error"]
            old["stale_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            try:
                write_cache(path, old)
            except OSError:
                pass
            return old
        # No earlier state: cache the error too, so it is retried after the TTL, not every tick
        try:
            write_cache(path, data)
        except OSError:
            pass
    else:
        line = None
        if job.get("stage") == "pr-open" and not job.get("adopted"):
            repo = gh_repo(job.get("pr_url"))
            line = infra_check(forge, data, old, ["-R", repo] if repo else None)
        if line and not quiet:
            print(f"{job['id']}: {line}")
        write_cache(path, data)
        st, was = forge_state(data), forge_state(old or {})
        if st == "merged" or (st == "closed" and was != "closed"):
            for l in job_prs(job["id"]):
                if not quiet:
                    print(f"{job['id']}: {l}")
    return data


def forge_state(data):
    """merged|closed|open|'' of a cached CI entry (GitLab mr_state, GitHub pr_state)."""
    st = str(data.get("mr_state") or data.get("pr_state") or "").lower()
    return {"opened": "open"}.get(st, st)


def job_prs(job_id):
    """Run `.factory/job prs <id>` (the only writer of job.json): a merged PR/MR marks the job merged
    and closes its issues, a closed one is reported. Returns its output lines."""
    try:
        r = subprocess.run([os.path.join(HERE, "job"), "prs", job_id], capture_output=True, text=True,
                           timeout=300, cwd=REPO)
    except (OSError, subprocess.TimeoutExpired) as e:
        return [f"job prs failed: {e}"]
    return [l for l in (r.stdout or r.stderr or "").splitlines() if l.strip()]


# ---------- wait for the job's head pipeline (`.factory/ci wait <job-id>`) ----------

def git_out(*args, cwd=None):
    r = subprocess.run(["git", *args], capture_output=True, text=True, cwd=cwd or REPO)
    return r.stdout.strip() if r.returncode == 0 else ""


def job_head(job):
    """The job's current head: its worktree's HEAD, else its local branch, else the remote one."""
    wt = job.get("worktree")
    if wt and os.path.isdir(wt):
        sha = git_out("rev-parse", "HEAD", cwd=wt)
        if sha:
            return sha
    br = job.get("branch") or ""
    remote = (load_config().get("delivery") or {}).get("remote") or "origin"
    for ref in (f"refs/heads/{br}", f"refs/remotes/{remote}/{br}"):
        sha = git_out("rev-parse", "-q", "--verify", ref + "^{commit}") if br else ""
        if sha:
            return sha
    return None


def push_time(job, sha):
    """ISO time a minute before the head was pushed (validate.json of a round with that head), else
    before its commit time: a GitLab merged-results pipeline created after it counts."""
    jd = os.path.join(HERE, "jobs", job["id"])
    for p in sorted(glob_rounds(jd), reverse=True):
        try:
            st = json.load(open(os.path.join(p, "validate.json")))
        except (OSError, ValueError):
            continue
        if st.get("head") == sha and isinstance(st.get("pushed_at"), (int, float)):
            return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(st["pushed_at"] - 60))
    ct = git_out("show", "-s", "--format=%ct", sha)
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(int(ct) - 60)) if ct.isdigit() else None


def glob_rounds(jd):
    try:
        return [os.path.join(jd, d) for d in os.listdir(jd) if re.match(r"round-\d+$", d)]
    except OSError:
        return []


def pr_state_now(forge, job):
    """merged|closed|open|None of the job's PR/MR on the forge."""
    url = job.get("pr_url")
    if not url:
        return None
    if forge == "gitlab":
        mr = fetch_gitlab({"pr_url": url}, pid=":id")
        return None if mr.get("error") else forge_state(mr)
    if forge == "github":
        pr, err = run(["gh", "pr", "view", url, "--json", "state"])
        return None if err or not isinstance(pr, dict) else forge_state({"pr_state": pr.get("state")})
    return None


def cmd_wait(args):
    """`wait <job-id> [--timeout S]`: one final line, exit 0 (SUCCESS, MERGED) or 1 (see the doc)."""
    timeout = 3600.0
    if "--timeout" in args:
        try:
            timeout = float(args[args.index("--timeout") + 1])
        except (IndexError, ValueError):
            print("CI: ERROR usage: .factory/ci wait <job-id> [--timeout S]")
            return 2
    ids = [a for i, a in enumerate(args) if not a.startswith("-") and (i == 0 or args[i - 1] != "--timeout")]
    jobs = [j for j in load_jobs() if ids and (j["id"] == ids[0] or j["id"].startswith(ids[0] + "-"))]
    if len(jobs) != 1:
        print(f"CI: ERROR no job '{ids[0] if ids else ''}'")
        return 2
    job, cfg = jobs[0], load_config()
    forge = (cfg.get("forge") or "github").lower()
    os.chdir(REPO)   # gh/glab find the project from the checkout's remote
    v = cfg.get("validate") if isinstance(cfg.get("validate"), dict) else {}
    try:
        poll = float(os.environ.get("FACTORY_CI_POLL", v.get("poll_s", 30)))
    except (TypeError, ValueError):
        poll = 30.0
    sha = job_head(job)
    if not sha:
        print(f"CI: ERROR {job['id']}: no head commit (no worktree, no branch {job.get('branch')})")
        return 1
    since, end, errors, res = push_time(job, sha), time.time() + timeout, 0, {}
    tag = f"{job['id']} {sha[:12]}"
    while True:
        st = pr_state_now(forge, job)
        if st == "merged":
            lines = job_prs(job["id"])
            print(f"CI: MERGED {tag} {job.get('pr_url')}: merged on the forge"
                  + (f" ({'; '.join(l for l in lines if not l.startswith('DONE:'))[:300]})" if lines else ""))
            return 0
        if st == "closed":
            print(f"CI: CLOSED {tag} {job.get('pr_url')}: closed without merge, a human decides")
            return 1
        res = head_pipeline(forge, job.get("branch") or "", sha, job.get("pr_url"), since)
        if res.get("error"):
            errors += 1
            if errors >= 10:
                print(f"CI: ERROR {tag}: the forge did not answer {errors} times in a row ({res['error'][:160]})")
                return 1
        else:
            errors = 0
            p, js = res.get("pipeline"), res.get("jobs") or []
            url = f" {res['url']}" if res.get("url") else ""
            if p == "success" or (p in ("skipped", "manual") and js and
                                  all(j.get("status") in ("success", "skipped", "manual") for j in js)):
                print(f"CI: SUCCESS {tag}: {len(js)} jobs passed{url}")
                return 0
            if p in ("failed", "canceled"):
                bad = [j for j in js if j.get("status") in ("failed", "canceled")]
                names = ", ".join(j["name"] for j in bad[:6]) or f"pipeline {p}"
                why = infra_reason(js, failed_logs(forge, js)) if p == "failed" and \
                    all(j.get("status") == "failed" for j in bad) else None
                if why:
                    print(f"CI: INFRA ({why}) {tag}: {names}{url}")
                else:
                    print(f"CI: FAILED {tag}: {names}{url}")
                return 1
        if time.time() + poll > end:
            last = res.get("error") or res.get("pipeline") or "none"
            print(f"CI: TIMEOUT {tag}: still {last} after {int(timeout)}s; start the wait again")
            return 1
        time.sleep(max(poll, 0))


def main():
    args = sys.argv[1:]
    if args[:1] == ["wait"]:
        sys.exit(cmd_wait(args[1:]))
    ttl = TTL_DEFAULT
    quiet = "--quiet" in args
    force = "--ttl" in args and "0" in args
    if "--ttl" in args:
        try:
            ttl = int(args[args.index("--ttl") + 1])
            force = ttl == 0
        except (IndexError, ValueError):
            pass
    if "--once" in args:
        force = True
    cfg = load_config()
    forge = (cfg.get("forge") or "github").lower()
    jobs = load_jobs()
    targets = [a for a in args if not a.startswith("-")]
    if targets and targets[0] != "all":
        jobs = [j for j in jobs if j["id"] in targets or j["id"].startswith(targets[0])]
        if not jobs:
            sys.exit(f"no job '{targets[0]}'")
    pr_jobs = [j for j in jobs if watched(j)]
    pid = None
    force = force or "--once" in args
    stale = [j for j in pr_jobs if force or not cache_fresh(cache_path(j["id"]), ttl)]
    if forge == "gitlab" and stale:
        pid, _ = gitlab_project_id()
    results = [refresh_job(j, forge, ttl, force, quiet, pid) for j in pr_jobs]
    results = [r for r in results if r]

    if targets and not quiet:
        for r in results:
            print(f"== {r.get('job')}  pipeline={r.get('pipeline')} merge={r.get('merge')}")
            if (r.get("infra") or {}).get("line"):
                print(f"   {r['infra']['line']}")
            if r.get("error"):
                print(f"   error: {r['error']}")
            for jb in r.get("jobs", []):
                stage = f"[{jb['stage']}] " if jb.get("stage") else ""
                print(f"   {jb['status']:<8} {stage}{jb['name']}")
        return
    if "--others" in args or quiet:
        others_path = os.path.join(CACHE, "ci-others.json")
        if not force and cache_fresh(others_path, max(ttl, 60)):
            pass
        else:
            if forge == "github":
                others = fetch_github_others()
            elif forge == "gitlab":
                pid = pid or gitlab_project_id()[0]
                others = fetch_gitlab_others(pid) if pid else {"error": "unknown project"}
            else:
                others = {"error": f"unknown forge '{forge}'"}
            write_cache(others_path, others)  # an error too: retried after the TTL, not every tick
        if "--others" in args and not quiet:
            print(json.dumps(read_cache(others_path) or {}, indent=2))
            return
    if "--others" in args and not quiet:
        return
    if not quiet:
        ok = sum(1 for r in results if not r.get("error"))
        fail = sum(1 for r in results if r.get("pipeline") == "failed")
        print(f"ci: {len(results)} jobs with a PR/MR, {ok} fetched"
              + (f", {fail} failing" if fail else ""))
        for r in results:
            n = len(r.get("jobs", []))
            print(f"  {r.get('job')}: {r.get('pipeline')} ({n} checks/jobs)"
                  + (f"  {r['infra']['line']}" if (r.get("infra") or {}).get("line") else ""))


if __name__ == "__main__":
    main()
