# An environment-only deviation in the audit table: `⚠️ ENV: <cause>` up to the end of the cell
ENV_MARK = re.compile(r"⚠\ufe0f?\s*ENV:([^|]*)")
ENV_EVIDENCE = re.compile(r"\bload\s*(average\s*)?[:=]?\s*\d|\bnetwork\b|\bDNS\b|\btimeout\b.*\bnetwork", re.I)
