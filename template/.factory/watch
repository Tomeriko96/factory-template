#!/usr/bin/env python3
"""Factory board: shows every job in .factory/jobs/*/job.json.

  .factory/watch          live board (refreshes every 2s, ctrl-c stops)
  .factory/watch --once   print once and exit
  .factory/watch --tmux   open the board in a split pane at the bottom (inside tmux)
  .factory/watch <job-id> detail: files in the job folder + first lines of decision.md
Unknown keys in job.json are ignored; missing fields show '-'.
"""
import json, os, subprocess, sys, time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))  # <repo>/.factory

def load(jobs_dir):
    jobs = []
    if not os.path.isdir(jobs_dir):
        return jobs
    for name in sorted(os.listdir(jobs_dir)):
        p = os.path.join(jobs_dir, name, "job.json")
        try:
            with open(p) as f:
                j = json.load(f)
        except (OSError, ValueError):
            continue
        j.setdefault("id", name)
        jobs.append(j)
    return jobs

def age(iso):
    try:
        t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
        s = int((datetime.now(timezone.utc) - t).total_seconds())
        return f"{s//3600}h{s%3600//60:02d}m" if s >= 3600 else f"{s//60}m{s%60:02d}s"
    except Exception:
        return "-"

COL = {"needs-human": "\033[1;31m", "merged": "\033[32m", "pr-open": "\033[32m", "pushed": "\033[32m", "review": "\033[33m",
       "build": "\033[36m", "approve": "\033[35m", "spec": "\033[34m"}

def paint(text, stage):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"{COL.get(stage, '')}{text}\033[0m"

def detail(jobs_dir, job_id):
    d = os.path.join(jobs_dir, job_id)
    if not os.path.isdir(d):
        return f"no job '{job_id}'"
    out = [f"== {job_id}"]
    for dp, _, fs in sorted(os.walk(d)):
        for f in sorted(fs):
            out.append("  " + os.path.relpath(os.path.join(dp, f), d))
    for f in ("decision.md",):
        p = os.path.join(d, f)
        if os.path.exists(p):
            out += ["", f"-- {f}"] + open(p).read().splitlines()[:12]
    return "\n".join(out)

def render(jobs):
    if not jobs:
        return "factory board: no jobs yet"
    sym = {"PASS": "✓", "CHANGES": "✗", None: "·"}
    lines = [f"{'JOB':<32} {'MODE':<5} {'STAGE':<12} {'RND':>3} {'PORT':>5}  {'REVIEWS':<38} UPDATED"]
    for j in jobs:
        revs = j.get("reviews") or {}
        r = " ".join(f"{k}{sym.get(v, '?')}" for k, v in revs.items()) or "-"
        lines.append(paint(f"{str(j['id'])[:32]:<32} {str(j.get('mode', '-')):<5} "
                           f"{str(j.get('stage', '-')):<12} "
                           f"{j.get('round', '-')!s:>3} {j.get('port', '-')!s:>5}  "
                           f"{r:<38} {age(j['updated']) if j.get('updated') else '-'}",
                           j.get("stage")))
    return "\n".join(lines)

def main():
    jobs_dir = os.path.join(HERE, "jobs")
    if "--tmux" in sys.argv:
        if not os.environ.get("TMUX"):
            sys.exit("not inside tmux; just run .factory/watch")
        subprocess.run(["tmux", "split-window", "-v", "-l", "12", "-c", os.path.dirname(HERE),
                        os.path.abspath(__file__)])
        return
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if args:
        print(detail(jobs_dir, args[0]))
        return
    if "--once" in sys.argv:
        print(render(load(jobs_dir)))
        return
    try:
        while True:
            print("\033[2J\033[H" + render(load(jobs_dir)) + "\n\n(ctrl-c to stop)")
            time.sleep(2)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
