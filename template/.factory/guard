#!/usr/bin/env python3
"""PreToolUse hook for the factory's agents: heavy commands must go through .factory/heavy.

Wired in the frontmatter of every factory agent:

    hooks:
      PreToolUse:
        - matcher: "Bash"
          hooks:
            - type: command
              command: "\"$CLAUDE_PROJECT_DIR\"/.factory/guard"

Reads the hook JSON on stdin. If a Bash command would start a test run, build, install,
type-check or screenshot run without `.factory/heavy` in front of it, exit 2 with a message
(Claude Code feeds stderr back to the agent). Everything else, and any parse problem, is
allowed: this is a guard rail against forgetting, not a sandbox.

Switch off with `"limits": {"guard": false}` in .factory/config.json.
"""
import json, os, re, shlex, sys

HERE = os.path.dirname(os.path.abspath(__file__))
HEAVY_WORDS = {"pytest", "py.test", "vitest", "jest", "mypy", "pyright", "tox", "nox", "tsc", "playwright"}
RUNNERS = {"uv", "uvx", "npx", "pnpm", "yarn", "python", "python3", "poetry", "pipx", "npm",
           "bun", "bunx", "node", "env", "nice", "time", "ionice", "timeout", "sudo", "xvfb-run"}
PKG = {"npm", "pnpm", "yarn", "bun"}
PKG_HEAVY = {"ci", "install", "i", "test", "t", "build", "add", "rebuild"}
SHELLS = {"bash", "sh", "zsh", "dash"}
BUILD_TOOLS = {"make", "just"}
BUILD_TARGETS = {"test", "tests", "check", "ci", "build", "lint", "all", "validate"}
ENV_ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?\n[ \t]*\2[ \t]*(?=\n|$)", re.S)


def segments(cmd):
    """Split on ; & | && || ( ) and newlines that are outside quotes."""
    out, cur, quote, i = [], [], None, 0
    while i < len(cmd):
        c = cmd[i]
        if quote:
            cur.append(c)
            if c == "\\" and quote == '"' and i + 1 < len(cmd):
                cur.append(cmd[i + 1])
                i += 1
            elif c == quote:
                quote = None
        elif c in "'\"":
            quote = c
            cur.append(c)
        elif c == "\\" and i + 1 < len(cmd):
            cur.append(c + cmd[i + 1])
            i += 1
        elif c in ";&|()\n":
            out.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    out.append("".join(cur))
    return [s.strip() for s in out if s.strip()]


def words(seg):
    try:
        w = shlex.split(seg)
    except ValueError:
        w = seg.split()
    while w and (ENV_ASSIGN.match(w[0]) or w[0] in ("exec", "command", "!")):
        w = w[1:]
    return w


def base(w):
    return os.path.basename(w)


def heavy_reason(cmd, depth=0):
    """Return a short description if `cmd` starts something heavy outside .factory/heavy."""
    cmd = HEREDOC.sub("", cmd)
    for seg in segments(cmd):
        w = words(seg)
        if not w:
            continue
        first = base(w[0])
        if first in ("heavy", "serve", "watch", "precheck", "guard"):
            continue
        if first in SHELLS and "-c" in w[1:] and depth < 3:
            i = w.index("-c")
            if i + 1 < len(w):
                r = heavy_reason(w[i + 1], depth + 1)
                if r:
                    return r
            continue
        if first == "shoot":
            return ".factory/shoot"
        if first in ("pre-push.sh",) or (first in SHELLS and len(w) > 1 and base(w[1]) == "pre-push.sh"):
            return "pre-push.sh"
        if first in HEAVY_WORDS:
            return first
        if first == "uv" and len(w) > 1 and w[1] in ("sync", "pip") :
            return "uv " + w[1]
        if first == "pip" or first == "pip3":
            if len(w) > 1 and w[1] == "install":
                return "pip install"
        if first in PKG:
            rest = [x for x in w[1:] if not x.startswith("-")]
            if rest and (rest[0] in PKG_HEAVY or (rest[0] in ("run", "exec") and len(rest) > 1 and
                                                   (rest[1] in PKG_HEAVY or rest[1] in HEAVY_WORDS or rest[1] in BUILD_TARGETS))):
                return f"{first} {' '.join(rest[:2])}"
        if first in RUNNERS:
            for tok in w[1:]:
                if base(tok) in HEAVY_WORDS:
                    return f"{first} … {base(tok)}"
                if tok == "-m" :
                    continue
        if first in BUILD_TOOLS:
            rest = [x for x in w[1:] if not x.startswith("-")]
            if rest and rest[0] in BUILD_TARGETS:
                return f"{first} {rest[0]}"
        if first == "mkdocs" and len(w) > 1 and w[1] == "build":
            return "mkdocs build"
        if first in ("cargo", "go") and len(w) > 1 and w[1] in ("test", "build"):
            return f"{first} {w[1]}"
        if first in ("docker", "podman") and len(w) > 1 and w[1] == "build":
            return f"{first} build"
    return None


def main():
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            if (json.load(f).get("limits") or {}).get("guard") is False:
                return 0
    except (OSError, ValueError):
        pass
    try:
        data = json.load(sys.stdin)
        cmd = (data.get("tool_input") or {}).get("command") or ""
        what = heavy_reason(cmd)
    except Exception:
        return 0
    if what:
        sys.stderr.write(
            f"factory guard: `{what}` is a heavy command and must go through the limiter, "
            f"or parallel jobs overload the machine. Run it from the worktree root as\n"
            f"  {HERE}/heavy [--cache] -- <command>\n"
            f"(a compound command as `bash -c '…'`). For a long command start it in the "
            f"background with output to a log file and poll the log. Do not work around this.\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
