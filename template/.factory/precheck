def load_config():
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def validate_mode(job, cfg):
    """`ci` when config.validate.mode is ci and the job is delivered as a PR/MR, else `local`."""
    v = cfg.get("validate") if isinstance(cfg.get("validate"), dict) else {}
    delivery = job.get("delivery_mode") or (cfg.get("delivery") or {}).get("mode") or "local"
    return "ci" if v.get("mode") == "ci" and delivery == "pr" else "local"


def env_num(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return default


def ci_module():
    import importlib.machinery, importlib.util
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("factory_ci", os.path.join(HERE, "ci"))
    spec = importlib.util.spec_from_loader("factory_ci", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t))


def sh(cmd, cwd=None, timeout=60):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout,
                           env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
        return r.returncode, (r.stdout or ""), (r.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def find_or_open_pr(job, cfg, draft, job_dir):
    """(url, draft, error): the job branch's open PR/MR, opened now if there is none."""
    forge = (cfg.get("forge") or "github").lower()
    branch, base = job["branch"], job["base"]
    title = (job.get("feature") or job["id"]).splitlines()[0].strip()[:72] or job["id"]
    body = (f"Factory job {job['id']}: {title}\n\nOpened by the factory's validation step, so the CI pipeline "
            "runs on this branch before the approver; the description is replaced when the job is delivered.\n\n"
            "🤖 Generated with [Claude Code](https://claude.com/claude-code)\n")
    bf = os.path.join(job_dir, "pr-body.md")
    if not os.path.exists(bf):
        open(bf, "w").write(body)
    if forge == "github":
        rc, out, err = sh(["gh", "pr", "list", "--head", branch, "--state", "open", "--json", "url,isDraft"], cwd=REPO)
        if rc == 0 and out.strip():
            try:
                found = json.loads(out)
            except ValueError:
                found = []
            if found and not found[0].get("isDraft"):   # ready (a rework of a delivered job): draft again
                rc, out, err = sh(["gh", "pr", "ready", found[0].get("url") or "", "--undo"], cwd=REPO)
                if rc != 0:
                    return None, False, (f"{found[0].get('url')} is ready for review and could not be made a draft "
                                         f"(gh pr ready --undo: {(err or out).strip()[-200:]}); a ready PR/MR before the "
                                         "approver could be merged")
            if found:
                return found[0].get("url"), True, None
        rc, out, err = sh(["gh", "pr", "create", "--base", base, "--head", branch, "--title", title,
                           "--body-file", bf] + (["--draft"] if draft else []), cwd=REPO)
        urls = re.findall(r"https?://\S+/pull/\d+", out)
        return (urls[-1], draft, None) if rc == 0 and urls else (None, draft, f"gh pr create failed: {(err or out).strip()[-300:]}")
    if forge == "gitlab":
        q = urllib.parse.quote(branch, safe="")
        rc, out, err = sh(["glab", "api", f"projects/:id/merge_requests?source_branch={q}&state=opened"], cwd=REPO)
        try:
            found = json.loads(out) if rc == 0 and out.strip() else []
        except ValueError:
            found = []
        if found and not (found[0].get("draft") or found[0].get("work_in_progress")):   # ready: draft again
            t = str(found[0].get("title") or title)
            rc, out, err = sh(["glab", "api", "-X", "PUT", f"projects/:id/merge_requests/{found[0].get('iid')}",
                               "-f", f"title=Draft: {t}"], cwd=REPO)
            if rc != 0:
                return None, False, (f"{found[0].get('web_url')} is ready for review and could not be made a draft "
                                     f"({(err or out).strip()[-200:]}); a ready MR before the approver could be merged")
        if found:
            return found[0].get("web_url"), True, None
        rc, out, err = sh(["glab", "api", "-X", "POST", "projects/:id/merge_requests",
                           "-f", f"source_branch={branch}", "-f", f"target_branch={base}",
                           "-f", f"title={'Draft: ' if draft else ''}{title}", "-f", f"description={open(bf).read()}"], cwd=REPO)
        try:
            mr = json.loads(out) if rc == 0 else {}
        except ValueError:
            mr = {}
        return (mr["web_url"], draft, None) if mr.get("web_url") else (None, draft, f"opening the MR failed: {(err or out).strip()[-300:]}")
    return None, draft, f"unknown forge '{forge}' in config.json"


def validate_ci(job, job_dir, rdir, rnd, head, cfg):
    """The full validation on the forge's CI: push, PR/MR if needed, wait for the pipeline (module doc)."""
    v = cfg["validate"]
    forge = (cfg.get("forge") or "github").lower()
    remote = (cfg.get("delivery") or {}).get("remote") or "origin"
    out = os.path.join(rdir, "validate.md")
    state_path = os.path.join(rdir, "validate.json")
    try:
        state = json.load(open(state_path))
    except (OSError, ValueError):
        state = {}
    if state.get("head") != head or state.get("mode") != "ci":
        state = {"mode": "ci", "head": head, "errors": 0}

    def save():
        with open(state_path + ".tmp", "w") as f:
            json.dump(state, f)
        os.replace(state_path + ".tmp", state_path)

    def finish(word, body):
        pr = state.get("pr_url")
        lines = [f"VALIDATE: {word}", f"Head: {head}"]
        lines += [f"PR: {pr} ({'draft' if state.get('pr_draft') else 'ready'}, opened for the CI validation)"] if pr else []
        lines += [f"Pipeline: {state['pipeline_url']}"] if state.get("pipeline_url") else []
        if v.get("draft") is False:
            body = body + ["", "NOTE: validate.draft is deprecated and ignored (v0.17.0): the validation's PR/MR is "
                           "always a draft until delivery; delivery marks it ready (delivery.draft)."]
        text = "\n".join(lines + [""] + body) + "\n"
        save()
        open(out, "w").write(text)
        print(text, end="")
        return 0

    wt = job["worktree"]
    if state.get("pushed") != head:
        rc, _, err = sh(["git", "-C", wt, "push", remote, f"HEAD:refs/heads/{job['branch']}"], timeout=120)
        if rc != 0:
            return finish("ERROR the job branch could not be pushed (never forced)",
                          [f"`git push {remote} {job['branch']}` failed:", "", "```", err.strip()[-1200:], "```"])
        state.update(pushed=head, pushed_at=time.time())
        save()
    if v.get("open_pr", True) and not state.get("pr_url"):
        # Always a draft until delivery (v0.17.0): a ready PR/MR at validation got auto-merge switched on
        # by hand and merged before the approver ran (prompt-library !711). validate.draft is ignored.
        url, is_draft, err = find_or_open_pr(job, cfg, True, job_dir)
        if err:
            return finish("ERROR the PR/MR for the CI pipeline could not be opened", [err])
        state.update(pr_url=url, pr_draft=is_draft)
        save()
    ci = ci_module()
    poll = env_num("FACTORY_CI_POLL", v.get("poll_s", CI_POLL))
    end = time.time() + env_num("FACTORY_VALIDATE_BUDGET", VALIDATE_BUDGET)
    no_pipe = 60 * env_num("FACTORY_CI_NO_PIPELINE_MIN", v.get("no_pipeline_min", CI_NO_PIPELINE_MIN))
    limit = 60 * float(v.get("timeout_min") or CI_TIMEOUT_MIN)
    while True:
        res = ci.head_pipeline(forge, job["branch"], head, state.get("pr_url"), iso(state["pushed_at"] - 60))
        age = time.time() - state["pushed_at"]
        if res.get("error"):
            state["errors"] = int(state.get("errors") or 0) + 1
            if state["errors"] >= CI_MAX_ERRORS:
                return finish("ERROR the forge did not answer", [f"{state['errors']} errors in a row: {res['error']}"])
        else:
            state["errors"] = 0
            state["pipeline_url"] = res.get("url") or state.get("pipeline_url")
            p = res.get("pipeline")
            jobs_ok = all(j.get("status") in ("success", "skipped", "manual") for j in res.get("jobs") or [])
            if p == "success" or (p in ("skipped", "manual") and res.get("jobs") and jobs_ok):
                retried = state.get("infra_retry") or {}
                return finish("PASS", [f"The full validation of round {rnd} ran on the forge's CI "
                                       f"(validate.mode ci): {len(res.get('jobs') or [])} jobs passed."]
                              + ([f"CI: INFRA ({retried['reason']}), retried: passed on the retry"] if retried.get("keys") else [])
                              + [""] + [f"- ✅ {j['name']}: {j['status']}" for j in res.get("jobs") or []])
            if p == "failed" and state.get("infra_retry") and \
                    set(ci.job_key(j) for j in res.get("jobs") or [] if j.get("status") == "failed") \
                    & set(state["infra_retry"].get("keys") or []):
                pass   # the forge still lists the jobs the infra retry replaces: wait for the retry
            elif p in ("failed", "canceled"):
                bad = [j for j in res.get("jobs") or [] if j.get("status") in ("failed", "canceled")]
                logs = ci.failed_logs(forge, res.get("jobs") or [])
                infra = ci.infra_reason(res.get("jobs") or [], logs) if p == "failed" and \
                    all(j.get("status") == "failed" for j in bad) else None
                if infra and not state.get("infra_retry"):
                    # a failed preview deploy (ci.preview_cleanup_job): the cleanup job runs first
                    keys, err, note = ci.retry_infra(forge, bad, res.get("jobs") or [], logs=logs)
                    state["infra_retry"] = {"reason": infra, "keys": keys, "at": time.time(), "error": err,
                                            **({"cleanup": note} if note else {})}
                    save()
                    if keys:
                        state["infra_retry"]["line"] = (f"CI: INFRA ({infra}), " + (f"{note}, " if note else "")
                                                        + "retried: " + ", ".join(j["name"] for j in bad))
                        save()
                        continue
                if infra:
                    first = state["infra_retry"]
                    body = [f"The full validation of round {rnd} ran on the forge's CI (validate.mode ci): the pipeline "
                            f"failed on infrastructure, not on the change: {infra}.",
                            f"CI: INFRA ({infra}), " + ("retried once, failed again" if first.get("keys") else
                                                       f"the retry could not be started ({first.get('error')})"), ""]
                    body += [f"- ❌ {j['name']}" + (f" [{j['stage']}]" if j.get("stage") else "") + f": {j['status']}"
                             + (f" ({j['url']})" if j.get("url") else "") for j in bad]
                    for name, tail in logs.items():
                        body += ["", f"## Failed: `{name}`", "", "```", tail[-3000:], "```"]
                    body += ["", "No rework round: the change is not at fault. Retry the pipeline later; once the "
                             "head pipeline is green on the forge, `.factory/job prs` counts the validation as passed."]
                    return finish(f"INFRA {infra}", body)
                body = [f"The full validation of round {rnd} ran on the forge's CI (validate.mode ci): the "
                        f"pipeline {p}.", ""]
                body += [f"- ❌ {j['name']}" + (f" [{j['stage']}]" if j.get("stage") else "") + f": {j['status']}"
                         + (f" ({j['url']})" if j.get("url") else "") for j in bad] or [f"- ❌ pipeline {p}"]
                for name, tail in logs.items():
                    body += ["", f"## Failed: `{name}`", "", "```", tail[-3000:], "```"]
                body += ["", "1. [blocking] the CI pipeline fails on this round's head (see above): fix the cause; "
                         "a flaky job or one that fails on the base too is no bug of this change, say so in build.md "
                         "with the evidence."]
                return finish("FAIL", body)
            if p in (None, "none") and age > no_pipe:
                return finish("ERROR no pipeline for the pushed commit",
                              [f"No CI pipeline appeared for {head[:12]} on {job['branch']} within "
                               f"{int(no_pipe // 60)} min" + (f" (PR/MR {state['pr_url']})" if state.get("pr_url") else "")
                               + ": CI does not run on this branch. Set validate.open_pr true, or validate.mode local."])
            if age > limit:
                return finish("ERROR the pipeline did not finish", [f"still {p} after {int(age // 60)} min"])
        if time.time() + poll > end:
            break
        time.sleep(max(poll, 0))
    save()
    pend = res.get("pipeline") if not res.get("error") else f"forge error ({res['error'][:120]})"
    print(f"VALIDATE: PENDING the CI pipeline is {pend} for {head[:12]}"
          + (f" ({state['pr_url']})" if state.get("pr_url") else "")
          + f": run `.factory/precheck --validate {job['id']}` again")
    if (state.get("infra_retry") or {}).get("line"):
        print(state["infra_retry"]["line"])
    return 124


def validate_main(job_id, rnd=None):
    """`--validate <job-id> [<round>]`: the one full-suite run of a round (see the module doc)."""
    job_dir = os.path.join(HERE, "jobs", job_id)
    with open(os.path.join(job_dir, "job.json")) as f:
        job = json.load(f)
    rnd = int(rnd or job.get("round") or 1)
    rdir = os.path.join(job_dir, f"round-{rnd}")
    os.makedirs(rdir, exist_ok=True)
    wt = job.get("worktree")
    if not wt or not os.path.isdir(wt):
        sys.exit(f"no worktree for {job_id}")
    head = git("rev-parse", "HEAD", cwd=wt)
    head = head.strip() if head else "?"
    cfg = load_config()
    if validate_mode(job, cfg) == "ci":
        os.chdir(REPO)   # gh/glab find the project from the checkout's remote
        return validate_ci(job, job_dir, rdir, rnd, head, cfg)
    cmds = validate_commands()
    out = os.path.join(rdir, "validate.md")
    if not cmds:
        text = (f"VALIDATE: NONE no Validate commands in .factory/repo.md\nHead: {head}\n\n"
                "The full suite was not run; CI is the only full run.\n")
        open(out, "w").write(text)
        print(text, end="")
        return 0
    state_path = os.path.join(rdir, "validate.json")
    try:
        state = json.load(open(state_path))
    except (OSError, ValueError):
        state = {}
    if state.get("head") != head or state.get("cmds") != cmds:
        state = {"head": head, "cmds": cmds, "tickets": {}, "results": {}}
    heavy = os.path.join(HERE, "heavy")
    for c in cmds:
        tid = state["tickets"].get(c)
        if c in state["results"] or (tid and os.path.exists(os.path.join(HERE, "run", f"heavy-{tid}.json"))):
            continue
        try:
            argv = shlex.split(c)
        except ValueError as e:
            state["results"][c] = {"rc": 2, "tail": f"cannot parse the command: {e}"}
            continue
        r = subprocess.run([heavy, "--background", "--cache", "--priority", "high",
                            "--label", f"validate {job_id}: {c}"[:120], "--", *argv],
                           cwd=wt, capture_output=True, text=True)
        m = re.search(r"ticket (h[0-9a-f]+)", r.stdout or "")
        if not m:
            state["results"][c] = {"rc": 2, "tail": (r.stderr or r.stdout or "heavy gave no ticket").strip()[-800:]}
        else:
            state["tickets"][c] = m.group(1)
    end = time.time() + VALIDATE_BUDGET
    for c in cmds:
        if c in state["results"]:
            continue
        left = int(end - time.time())
        if left <= 0:
            break
        r = subprocess.run([heavy, "wait", state["tickets"][c], "--timeout", str(left)],
                           cwd=wt, capture_output=True, text=True)
        if r.returncode != 124:
            state["results"][c] = {"rc": r.returncode, "tail": (r.stdout or "")[-1500:],
                                   "cached": "CACHE HIT" in (r.stdout or "") + (r.stderr or "")}
    with open(state_path + ".tmp", "w") as f:
        json.dump(state, f)
    os.replace(state_path + ".tmp", state_path)
    pending = [c for c in cmds if c not in state["results"]]
    if pending:
        print(f"VALIDATE: PENDING {len(pending)} of {len(cmds)} command(s) still queued or running: "
              f"run `.factory/precheck --validate {job_id}` again")
        return 124
    failed = [c for c in cmds if state["results"][c]["rc"] != 0]
    lines = [f"VALIDATE: {'FAIL' if failed else 'PASS'}", f"Head: {head}", "",
             f"The full validation of round {rnd} (repo.md Validate, through `heavy --cache`), "
             "run once by the precheck step.", ""]
    for c in cmds:
        res = state["results"][c]
        lines.append(f"- {'✅' if res['rc'] == 0 else '❌'} `{c}`: exit {res['rc']}"
                     + (" (cache hit)" if res.get("cached") else ""))
    for c in failed:
        lines += ["", f"## Failed: `{c}`", "", "```", state["results"][c]["tail"].rstrip()[-1500:], "```"]
    if failed:
        lines += ["", "1. [blocking] the full validation fails on this round's head (see above): fix the cause; "
                  "a failure only under high load (`heavy status`) is no bug, say so in build.md."]
    text = "\n".join(lines) + "\n"
    open(out, "w").write(text)
    print(text, end="")
    return 0


# ---------- PR/MR body: one closing line per issue ----------
FOOTER = "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
HELD_HEADING = "## Auto-merge hold overridden"
ACCEPTED_HEADING = "## Audit deviations accepted by the approver"
KEYWORD_RE = r"(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)"


def job_issues(job):
    nrs = job.get("issues")
    if isinstance(nrs, list):
        return [n for n in nrs if isinstance(n, int) and not isinstance(n, bool)]
    return [job["issue"]] if isinstance(job.get("issue"), int) else []


def issue_link(cfg):
    word = str(((cfg.get("issues") or {}).get("link")) or "Closes").strip()
    return word if re.fullmatch(r"[A-Za-z]+", word) else "Closes"


def pr_section(path):
    """(title, body) of the `## PR` section of an agent file (title = its first non-empty line)."""
    try:
        text = open(path, errors="replace").read()
    except OSError:
        return None, None
    m = re.search(r"^## PR[ \t]*$", text, re.M)
    if not m:
        return None, None
    lines = text[m.end():].lstrip("\n").splitlines()
    while lines and not lines[0].strip():
        lines.pop(0)
    if not lines:
        return None, None
    return lines[0].strip().lstrip("#").strip(), "\n".join(lines[1:]).strip()


def closing_report(nrs, text, link="Closes"):
    """(closed, partial, missing) for the issues nrs in a PR/MR body: closed = named on a line with a
    closing keyword (or with issues.link when that is not a closing word, e.g. Refs for mirrored repos);
    partial = {nr: note} named only with `Refs #N` (a `left:` note on the line says what is left); missing = the rest."""
    closed, partial = [], {}
    words = KEYWORD_RE if re.fullmatch(KEYWORD_RE, link, re.I) else f"(?:{KEYWORD_RE}|{re.escape(link)})"
    for line in (text or "").splitlines():
        for m in re.finditer(rf"\b{words}\b:?[ \t]+((?:#\d+(?:[ \t]*(?:,|and|&)[ \t]*)?)+)", line, re.I):
            closed += [int(x) for x in re.findall(r"#(\d+)", m.group(1))]
        left = re.search(r"\bleft:\s*(.+)", line, re.I)
        note = "left: " + left.group(1).strip().rstrip(")").strip()[:200] if left else "refs only: no closing keyword, no `left:` note"
        if not left and re.search(r"closed? (it |them |these |this )?(by hand|manually)", line, re.I):
            continue   # "Refs #N, closed by hand after the merge" is a promise, not partial work: it gets a closing line
        for x in re.findall(r"\bRefs?\b:?[ \t]+#(\d+)", line, re.I):
            partial.setdefault(int(x), note)   # `Refs #N` never closes (a note after `left:` says what is open)
    closed_set = set(closed)
    missing = [n for n in nrs if n not in closed_set and n not in partial]
    return [n for n in nrs if n in closed_set], {n: v for n, v in partial.items() if n in nrs and n not in closed_set}, missing


def pr_body_main(job_id):
    """`--pr-body <job-id>`: write <job>/pr-body.md from the PR text of the job (its `## PR` section)
    with one `<issues.link> #N` line per issue it fully fixes (the bundle issue and every member), a
    partial issue (`Refs #N … left: …`) kept as it is, and the Claude Code footer. Prints the result."""
    job_dir = os.path.join(HERE, "jobs", job_id)
    with open(os.path.join(job_dir, "job.json")) as f:
        job = json.load(f)
    cfg = load_config()
    link, nrs = issue_link(cfg), job_issues(job)
    src = job.get("pr_text")
    title, body = pr_section(os.path.join(job_dir, src)) if src else (None, None)
    if title is None:
        title = re.sub(r"\s+", " ", str(job.get("feature") or job_id).splitlines()[0])[:70]
        body = "Approved by the user without a full review pass." if job.get("approved_by") else \
            "No PR text from the factory's agents."
    closed, partial, missing = closing_report(nrs, body, link)
    lines = [body.rstrip(), ""]
    if missing:
        lines += [f"{link} #{n}" for n in missing] + [""]
    rules, _ = docs_rules(cfg)
    names = diff_names(job) if rules else None
    if names:
        _, waived = docs_check(names, rules, docs_waivers(job_waiver_texts(job_dir, int(job.get("round") or 1))))
        quote = [w for _, _, w in waived if w not in body]
        if quote:   # a docs rule waived outside the PR text (build.md): whoever reviews the PR/MR sees why
            lines += list(dict.fromkeys(quote)) + [""]
    acc = [line for _, line in accepted_deviations(job_dir, latest_audit(job_dir, int(job.get("round") or 1))).values()
           if line not in body]
    if acc:   # the approver accepted an audit deviation: whoever reviews the PR/MR sees which and why
        lines += [ACCEPTED_HEADING, ""] + [f"- {a}" for a in acc] + [""]
    held = (job.get("auto_merge") or {}).get("held") or []
    if held:   # delivery.auto_merge_held: auto-merge is on although the factory would hold it; say why here
        lines += [HELD_HEADING, "", "Auto-merge is on (`delivery.auto_merge_held`), although the factory would "
                  "have held this PR/MR for a human:", ""] + [f"- {h}" for h in held] + [""]
    text = "\n".join(lines).rstrip() + "\n"
    if FOOTER not in text:
        text += "\n" + FOOTER + "\n"
    path = os.path.join(job_dir, "pr-body.md")
    with open(path, "w") as f:
        f.write(text)
    out = [f"PR-BODY: {path}", f"PR-TITLE: {title}"]
    if nrs:
        out.append("CLOSING: " + (", ".join(f"#{n}" for n in nrs if n not in partial) or "none"))
    if missing:
        out.append("NOTE: the PR text did not close " + ", ".join(f"#{n}" for n in missing)
                   + f" with a closing keyword: added a `{link} #N` line for each")
    out += [f"PARTIAL: #{n}: {note}" for n, note in partial.items()]
    print("\n".join(out))
    return 0


def closes_main(job_id, path):
    """`--closes <job-id> [<file>]`: check a PR/MR body (default <job>/pr-body.md): exit 1 and name
    the issues of the job that it neither closes nor marks partial."""
    job_dir = os.path.join(HERE, "jobs", job_id)
    with open(os.path.join(job_dir, "job.json")) as f:
        job = json.load(f)
    try:
        text = open(path or os.path.join(job_dir, "pr-body.md"), errors="replace").read()
    except OSError as e:
        print(f"CLOSES: MISSING all ({e})")
        return 1
    _, partial, missing = closing_report(job_issues(job), text, issue_link(load_config()))
    if missing:
        print("CLOSES: MISSING " + ", ".join(f"#{n}" for n in missing)
              + " (one closing keyword line per issue, e.g. `Closes #N`; partial work: `Refs #N (left: <what>)`)")
        return 1
    print("CLOSES: OK" + (" (partial: " + ", ".join(f"#{n}" for n in partial) + ")" if partial else ""))
    return 0


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    if sys.argv[1] == "--pr-body":
        if len(sys.argv) != 3:
            sys.exit(__doc__)
        sys.exit(pr_body_main(sys.argv[2]))
    if sys.argv[1] == "--closes":
        if len(sys.argv) not in (3, 4):
            sys.exit(__doc__)
        sys.exit(closes_main(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None))
    if sys.argv[1] == "--validate":
        if len(sys.argv) not in (3, 4):
            sys.exit(__doc__)
        sys.exit(validate_main(*sys.argv[2:4]))
    if sys.argv[1] == "--hold":
        if len(sys.argv) != 3:
            sys.exit(__doc__)
        return hold_main(sys.argv[2])
    job_id = sys.argv[1]
    job_dir = os.path.join(HERE, "jobs", job_id)
    with open(os.path.join(job_dir, "job.json")) as f:
        job = json.load(f)
    rnd = int(sys.argv[2]) if len(sys.argv) > 2 else int(job.get("round") or 1)
    rdir = os.path.join(job_dir, f"round-{rnd}")
    wt, base, branch = job.get("worktree"), job.get("base"), job.get("branch")
    issues, notes, not_docs = [], [], []
    docs_mode = job.get("mode") == "docs"
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            globs = (json.load(f).get("limits") or {}).get("docs_globs") or DOCS_GLOBS
    except (OSError, ValueError):
        globs = DOCS_GLOBS

    extra_hold = extra_hold_globs()
    hold = {}  # file -> class
    diff_files = []

    required = [os.path.join(rdir, "build.md")] + ([] if docs_mode else [os.path.join(job_dir, "spec.md")])
    for p in required:
        if not os.path.exists(p):
            issues.append(f"missing {os.path.relpath(p, job_dir)}")

    # Latest verdict per reviewer across rounds: from round 2 on only some reviewers re-run
    latest = {}
    for r in range(1, rnd + 1):
        d = os.path.join(job_dir, f"round-{r}")
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if f.startswith("review-") and f.endswith(".md"):
                latest[f] = (r, os.path.join(d, f))
    reviews = sorted(latest)
    if docs_mode:
        build = os.path.join(rdir, "build.md")
        if os.path.exists(build) and not re.search(r"^## PR\b", open(build, errors="replace").read(), re.M):
            issues.append("build.md has no '## PR' section")
    elif not reviews:
        issues.append(f"no reviews in round-{rnd}")
    info = []
    verified = verified_reviews(job_dir)
    for f in reviews:
        r, path = latest[f]
        fl = first_line(path) or ""
        if UNVERIFIED_RE.match(fl):
            who = f[7:-3]
            if who in verified:
                notes.append(f"{f} (round {r}): PASS unverified, run by the approver: {verified[who]}")
            else:
                issues.append(f"{f} (round {r}): PASS unverified ({fl[len('VERDICT: PASS ('):].rstrip(')')}): "
                              f"the approver runs those tests (`VERIFIED: {who}: <command> → <result>`) or sends it back")
        elif fl != "VERDICT: PASS":
            issues.append(f"{f} (round {r}): first line is {fl!r}, not 'VERDICT: PASS'")
        text = open(path, errors="replace").read()
        info.append(f"{f[7:-3]} {text.count('[blocking]')}b/{text.count('[non-blocking]')}nb" + (f" (r{r})" if r != rnd else ""))

    if not docs_mode:
        vfl = first_line(os.path.join(rdir, "validate.md")) or ""
        if vfl.startswith("VALIDATE: FAIL"):
            issues.append(f"the full validation fails (round-{rnd}/validate.md)")
        elif vfl.startswith("VALIDATE: INFRA"):
            issues.append(f"the CI pipeline failed on infrastructure, not checked yet (round-{rnd}/validate.md: {vfl[16:].strip()})")
        elif vfl.startswith("VALIDATE: NONE"):
            notes.append("full validation not run: no Validate commands in repo.md")
        elif not vfl.startswith("VALIDATE: PASS"):
            notes.append(f"no full validation for round {rnd} (round-{rnd}/validate.md missing)")

    audit = latest.get("review-audit.md", (0, ""))[1]
    accepted = accepted_rows(job_dir)
    if audit and os.path.exists(audit):
        for line in open(audit, errors="replace"):
            if line.lstrip().startswith("|") and "---" not in line:
                nr = ROW_NR_RE.match(line)
                acc = accepted.get(nr.group(1)) if nr else None
                if acc and "❌" in line:
                    notes.append(f"ACCEPTED: audit row {nr.group(1)} is ❌ (a measured failure): an approver's "
                                 "ACCEPTED line does not cover it")
                elif acc and ("⏭" in line or "⚠" in line):
                    notes.append(f"audit row {nr.group(1)} accepted by the approver: {acc[0]}")
                    continue
                if "❌" in line or "⏭" in line:
                    issues.append("audit row not confirmed: " + re.sub(r"\s+", " ", line.strip())[:140])
                elif "⚠" in line:
                    row = re.sub(r"\s+", " ", line.strip())[:140]
                    # `⚠️ ENV: <cause, measured load>`: the deviation came from the machine (load,
                    # network), not the change. Only with a measured load or a network cause;
                    # any other ⚠️ in the row still counts.
                    # `⚠️ TEST: <why> · criterion verified by <evidence>`: a hidden acceptance test
                    # guessed the surface wrong and the audit verified the criterion independently.
                    envs = ENV_MARK.findall(line)
                    tests = TEST_MARK.findall(line)
                    rest = TEST_MARK.sub("", ENV_MARK.sub("", line))
                    bad_env = [e for e in envs if not ENV_EVIDENCE.search(e)]
                    bad_test = [t for t in tests if not TEST_EVIDENCE.search(t)]
                    if (envs or tests) and "⚠" not in rest and not bad_env and not bad_test:
                        kinds = " + ".join(k for k, v in (("ENV", envs), ("TEST", tests)) if v)
                        notes.append(f"audit {'environment' if not tests else 'test' if not envs else 'environment/test'}"
                                     f"-only (⚠️ {kinds}, not a deviation): " + row)
                    else:
                        why_dev = []
                        if "⚠" not in rest and bad_env:
                            why_dev.append("⚠️ ENV without a measured load or network cause")
                        if "⚠" not in rest and bad_test:
                            why_dev.append("⚠️ TEST without 'verified by <evidence>'")
                        notes.append("audit deviation: " + row + (f" ({'; '.join(why_dev)})" if why_dev else ""))

    files = lines = 0
    commits = "?"
    if wt and base and branch and os.path.isdir(wt):
        dbase = diff_base(job)
        if dbase != base:
            lb = (git("merge-base", base, branch, cwd=wt) or "").strip()
            if lb and lb != dbase:
                notes.append(f"diff base: the merge base with the fetched remote {base} ({dbase[:12]}); "
                             f"the local {base} lags it")
        numstat = git("diff", "--numstat", "--no-renames", "-z", f"{dbase}...{branch}", cwd=wt)
        if numstat is None:
            issues.append(f"cannot diff {base}...{branch} in {wt}")
        else:
            for row in filter(None, numstat.split("\0")):
                a, d, name = row.split("\t", 2)
                files += 1
                diff_files.append(name)
                if a == "-":
                    issues.append(f"binary file in diff: {name}")
                else:
                    lines += int(a) + int(d)
                if docs_mode and not is_doc(name, globs):
                    not_docs.append(name)
                if name.startswith((".factory/", ".claude/")):
                    issues.append(f"factory/claude file in diff: {name}")
                if SECRET.search(name):
                    issues.append(f"secret-looking file in diff: {name}")
                cls = hold_class(name, extra_hold)
                if cls:
                    hold[name] = cls
                size = git("cat-file", "-s", f"{branch}:{name}", cwd=wt)
                if size and size.strip().isdigit() and int(size) > MAX_BYTES:
                    issues.append(f"file over 1 MB in diff: {name}")
            if files > MAX_FILES or lines > MAX_LINES:
                issues.append(f"large diff: {files} files, {lines} changed lines")
            found = set()
            patch = git("diff", "--no-renames", "--no-color", "--no-ext-diff", "-U0",
                        f"{dbase}...{branch}", cwd=wt) or ""
            name = None
            for line in patch.splitlines():
                if line.startswith("+++ "):
                    # "+++ b/x", or quoted ("+++ \"b/x\"") for unusual names; /dev/null = deleted
                    raw = line[4:].strip('"')
                    name = None if raw == "/dev/null" else raw[2:] if raw.startswith("b/") else raw
                elif name and line.startswith("+"):
                    for kind, rx in SECRET_CONTENT:
                        if rx.search(line):
                            found.add((name, kind))
            for name, kind in sorted(found):
                issues.append(f"secret-looking content in diff ({kind}): {name}")
        commits = (git("rev-list", "--count", f"{dbase}..{branch}", cwd=wt) or "?").strip()
    else:
        issues.append("worktree, base or branch missing in job.json / on disk")

    nrs = job_issues(job)
    pr_src = os.path.join(rdir, "build.md") if docs_mode else os.path.join(job_dir, "decision.md")
    if nrs and os.path.exists(pr_src):
        _, body = pr_section(pr_src)
        if body is not None:
            _, partial, missing = closing_report(nrs, body, issue_link(load_config()))
            if missing:   # a note, not an issue: delivery adds the lines (--pr-body) and checks them (--closes)
                notes.append("closing lines: the PR text does not close " + ", ".join(f"#{n}" for n in missing)
                             + " (one `Closes #N` line per issue it fixes; partial work: `Refs #N (left: <what>)`); "
                             "delivery adds them (precheck --pr-body)")
            notes += [f"partial: #{n} stays open after the merge ({v})" for n, v in partial.items()]

    # docs rules: code that changed without the docs that describe it (mechanical, opt-in)
    rules, bad_rules = docs_rules(load_config())
    notes += bad_rules
    if rules and diff_files:
        missing, waived = docs_check(diff_files, rules, docs_waivers(job_waiver_texts(job_dir, rnd)))
        for why, hits in missing:
            issues.append(f"DOCS: missing update for {why} ({', '.join(hits[:3])}{' …' if len(hits) > 3 else ''}); "
                          "update the docs, or write `Docs: not needed: <reason>` in the PR text")
        notes += [f"DOCS: not needed for {why}: {reason}" for why, reason, _ in waived]

    if not_docs:
        issues.append("not documentation: " + ", ".join(not_docs[:8]) + (" …" if len(not_docs) > 8 else ""))
    verdict = "CLEAN" if not issues else "NOT-DOCS" if docs_mode and len(issues) == 1 and not_docs else "ISSUES"
    why = []
    if verdict != "CLEAN":
        why.append(f"precheck {verdict}")
    if any(n.startswith("audit deviation") for n in notes):
        why.append("audit has a deviation (⚠️)")
    for cls in sorted(set(hold.values())):
        names = sorted(n for n, c in hold.items() if c == cls)
        why.append(f"touches {cls}: " + ", ".join(names[:3]) + (" …" if len(names) > 3 else ""))
    # delivery.auto_merge_held: a hold (a file class, an audit deviation) is reported as `held: …` and
    # delivery switches auto-merge on anyway; a precheck issue (secrets, failing validation …) stays `no:`.
    held_ok = (load_config().get("delivery") or {}).get("auto_merge_held") is True and verdict == "CLEAN"
    am = ("held: " if held_ok else "no: ") + "; ".join(why) if why else "yes"
    out = [f"PRECHECK: {verdict}", "AUTO-MERGE: " + am, "",
           f"Job {job_id}, round {rnd}: {files} files, {lines} changed lines, {commits} commits.",
           "Reviews: " + (", ".join(info) or "none"), "", "## Issues"]
    out += [f"- {i}" for i in issues] or ["None."]
    out += ["", "## Notes"] + ([f"- {n}" for n in notes] or ["None."])
    text = "\n".join(out) + "\n"
    with open(os.path.join(job_dir, "precheck.md"), "w") as f:
        f.write(text)
    print(text, end="")


if __name__ == "__main__":
    main()
