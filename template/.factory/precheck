                     "uv.lock", "poetry.lock", "requirements*.txt", "Pipfile", "Pipfile.lock", "go.mod",
                     "go.sum", "Cargo.toml", "Cargo.lock", "Gemfile", "Gemfile.lock", "composer.json",
                     "composer.lock", "renv.lock", "DESCRIPTION"],
    "container/deploy": ["Dockerfile*", "docker-compose*.y*ml", "compose*.y*ml", "*/helm/*", "*/charts/*",
                         "*/k8s/*", "*/kubernetes/*", "*/terraform/*", "*.tf"],
    "schema/migrations": ["*/migrations/*", "*/alembic/*", "*.sql", "*/schema/*", "schema.*"],
    "auth": ["*/auth/*", "*/authn/*", "*/authz/*", "*/oauth*", "*/oidc*", "*/sso*", "*/saml*", "*/rbac*",
             "*/permissions*", "*/login*", "*/secrets/*"],
}


def glob_match(name, g):
    """A path glob: `**` spans directories, `*` and `?` stay within one; a glob without a "/"
    is matched against the file name only."""
    if "/" not in g:
        return fnmatch.fnmatchcase(os.path.basename(name), g)
    rx, i = "", 0
    while i < len(g):
        if g.startswith("**/", i):
            rx, i = rx + "(?:.*/)?", i + 3
        elif g.startswith("**", i):
            rx, i = rx + ".*", i + 2
        elif g[i] == "*":
            rx, i = rx + "[^/]*", i + 1
        elif g[i] == "?":
            rx, i = rx + "[^/]", i + 1
        else:
            rx, i = rx + re.escape(g[i]), i + 1
    return re.fullmatch(rx, name.lstrip("/")) is not None


WAIVER_RE = re.compile(r"^[\s>*-]*Docs:\s*not needed\b[^:\n]*:[ \t]*(\S.*)$", re.I | re.M)


# The approver accepts an audit row it re-measured or judged (decision.md, MERGE):
# `ACCEPTED: audit row <n>: <reason>`. A ⚠️ or ⏭️ row with such a line is confirmed: no issue, no
# deviation, and --pr-body quotes the reason. A ❌ row (a measured failure) is never accepted.
ACCEPT_RE = re.compile(r"^[\s>*-]*ACCEPTED:\s*audit\s+row\s+#?(\d+)\s*[:\u2014-]\s*(\S.*)$", re.I | re.M)
ROW_NR_RE = re.compile(r"^\s*\|\s*#?(\d+)\s*\|")


# A review whose required test run could not run (heavy queue, a timeout): not a plain pass
UNVERIFIED_RE = re.compile(r"^VERDICT: PASS \(unverified\b")
# The approver ran that review's tests itself: `VERIFIED: <reviewer>: <command → result>`
VERIFIED_RE = re.compile(r"^[\s>*-]*VERIFIED:\s*([\w-]+)\s*:\s*(\S.*)$", re.M)


def verified_reviews(job_dir):
    """{reviewer: what the approver ran} from the `VERIFIED: <reviewer>: …` lines of decision.md."""
    try:
        text = open(os.path.join(job_dir, "decision.md"), errors="replace").read()
    except OSError:
        return {}
    return {m.group(1).lower(): m.group(2).strip() for m in VERIFIED_RE.finditer(text)}


def accepted_rows(job_dir):
    """{row number: (reason, line)} from the `ACCEPTED: audit row <n>: <reason>` lines of decision.md."""
    try:
        text = open(os.path.join(job_dir, "decision.md"), errors="replace").read()
    except OSError:
        return {}
    return {m.group(1): (m.group(2).strip(), m.group(0).strip().lstrip(">*- ").strip()) for m in ACCEPT_RE.finditer(text)}


def latest_audit(job_dir, rnd):
    """The newest round-N/review-audit.md up to round rnd, or None."""
    for r in range(rnd, 0, -1):
        p = os.path.join(job_dir, f"round-{r}", "review-audit.md")
        if os.path.exists(p):
            return p
    return None


def accepted_deviations(job_dir, audit):
    """The approver's ACCEPTED lines that cover a ⚠️ or ⏭️ row (not ❌) of the audit table:
    {row number: (reason, line)}."""
    acc = accepted_rows(job_dir)
    if not acc or not audit:
        return {}
    out = {}
    for line in open(audit, errors="replace"):
        nr = ROW_NR_RE.match(line)
        if nr and nr.group(1) in acc and "❌" not in line and ("⚠" in line or "⏭" in line):
            out[nr.group(1)] = acc[nr.group(1)]
    return out


def docs_rules(cfg):
    """(valid rules, problems) from config.json `docs.rules`: [{"code": [globs], "docs": [globs], "why": str}]."""
    raw = cfg.get("docs").get("rules") if isinstance(cfg.get("docs"), dict) else None
    if raw is None:
        return [], []
    if not isinstance(raw, list):
        return [], ["docs.rules is not a list: ignored"]
    rules, bad = [], []
    for i, r in enumerate(raw):
        ok = isinstance(r, dict) and all(isinstance(r.get(k), list) and r.get(k) and
                                         all(isinstance(g, str) and g for g in r[k]) for k in ("code", "docs"))
        if not ok:
            bad.append(f"docs.rules[{i}] needs non-empty `code` and `docs` glob lists: ignored")
            continue
        rules.append({"code": r["code"], "docs": r["docs"], "why": str(r.get("why") or f"docs rule {i + 1}").strip()})
    return rules, bad


def docs_waivers(texts):
    """The `Docs: not needed: <reason>` lines of the given texts, as (line, reason)."""
    out = []
    for t in texts:
        for m in WAIVER_RE.finditer(t or ""):
            out.append((m.group(0).strip().lstrip(">*- ").strip(), m.group(1).strip()))
    return out


def docs_check(names, rules, waivers):
    """(missing, waived) for a diff: missing = [(why, code files)] for a rule whose code globs the
    diff touches while it touches none of its docs globs and no waiver covers it; waived =
    [(why, reason, waiver line)]. A waiver that names a rule's `why` covers that rule only; one
    that names no rule covers every rule."""
    missing, waived = [], []
    whys = [r["why"].lower() for r in rules]
    for r in rules:
        hits = [n for n in names if any(glob_match(n, g) for g in r["code"])]
        if not hits or any(glob_match(n, g) for n in names for g in r["docs"]):
            continue
        mine = [w for w in waivers if r["why"].lower() in w[0].lower()] or \
            [w for w in waivers if not any(y in w[0].lower() for y in whys)]
        if mine:
            waived.append((r["why"], mine[0][1], mine[0][0]))
        else:
            missing.append((r["why"], hits))
    return missing, waived


def job_waiver_texts(job_dir, rnd):
    """Where a `Docs: not needed` line counts: pr-body.md, decision.md, round-N/build.md."""
    texts = []
    for p in ("pr-body.md", "decision.md", os.path.join(f"round-{rnd}", "build.md")):
        try:
            texts.append(open(os.path.join(job_dir, p), errors="replace").read())
        except OSError:
            pass
    return texts


def diff_names(job):
    wt, base, branch = job.get("worktree"), job.get("base"), job.get("branch")
    names = git("diff", "--name-only", "--no-renames", "-z", f"{diff_base(job)}...{branch}", cwd=wt) \
        if wt and base and branch and os.path.isdir(wt) else None
    return None if names is None else [n for n in names.split("\0") if n]


def hold_class(name, extra):
    path = "/" + name
    for cls, globs in [*HOLD_CLASSES.items(), ("delivery.auto_merge_never", extra)]:
        for g in globs:
            if "/" in g:
                hit = fnmatch.fnmatch(path, g) or fnmatch.fnmatch(name, g) or \
                    (g.endswith("/**") and name.startswith(g[:-2].lstrip("*/")))
            else:
                hit = fnmatch.fnmatch(os.path.basename(name), g)
            if hit:
                return cls
    return None


def git(*args, cwd):
    try:
        r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=120,
                           env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


_DIFF_BASE = {}


def diff_base(job):
    """The commit the job's diff starts at: the newer of the branch's merge bases with the local
    `base` and with `<remote>/<base>`, fetched first (`git fetch <remote> <base>`, 60 s at most;
    FACTORY_NO_FETCH=1 skips it). The local base lags the forge after merges there: once a sync
    merged the remote base into the job branch, `<local base>...<branch>` would count the other
    MRs' files (CI config, docs, auth) as this job's and hold it for nothing. Falls back to `base`."""
    wt, base, branch = job.get("worktree"), job.get("base"), job.get("branch")
    key = (wt, base, branch)
    if key in _DIFF_BASE:
        return _DIFF_BASE[key]
    if not (wt and base and branch and os.path.isdir(wt)):
        return base
    remote = (load_config().get("delivery") or {}).get("remote") or "origin"
    if os.environ.get("FACTORY_NO_FETCH") != "1" and re.match(r"^[\w.-]+$", remote) and \
            git("remote", "get-url", remote, cwd=wt) is not None:
        sh(["git", "fetch", "-q", "--no-tags", remote, f"+refs/heads/{base}:refs/remotes/{remote}/{base}"],
           cwd=wt, timeout=60)
    bases = [b.strip() for b in (git("merge-base", ref, branch, cwd=wt)
                                 for ref in (base, f"refs/remotes/{remote}/{base}")) if b and b.strip()]
    pick = None
    for b in bases:
        if all(o == b or git("merge-base", "--is-ancestor", o, b, cwd=wt) is not None for o in bases):
            pick = b
            break
    if pick is None and bases:   # diverged (local commits on the base that the remote lacks): the closer one
        pick = min(bases, key=lambda b: int((git("rev-list", "--count", f"{b}..{branch}", cwd=wt) or "0").strip() or 0))
    _DIFF_BASE[key] = pick or base
    return pick


def is_doc(name, globs):
    for g in globs:
        if g.endswith("/**"):
            if name.startswith(g[:-2]):
                return True
        elif fnmatch.fnmatch(name, g) or fnmatch.fnmatch(os.path.basename(name), g):
            return True
    return False


