    def fn(job, out):
        if job.get("stage") not in ("needs-human", "queued"):
            raise Fail(f"{job['id']} is at {job.get('stage')}: only a needs-human or queued job can be dropped "
                       "(a running one: `job fail` it first)")
        if job.get("pr_url"):
            raise Fail(f"{job['id']} has an open PR/MR ({job['pr_url']}): close it on the forge first")
        start = job.get("stage")
        job.pop("syncing", None)
        set_stage(job, "superseded", "dropped" + (f": {reason}" if reason else ""))
        step(job, out, start)   # removes the worktree, see cleanup
        pushed = (job.get("delivery") or {}).get("mode") in ("push", "pr")
        if not pushed and git("rev-parse", "--verify", "-q", f"refs/heads/{job['branch']}"):
            if git("branch", "-d", job["branch"]) is None:
                out.notes.append(f"NOTE: branch {job['branch']} kept (git branch -d refused: it has commits that are not merged)")
    return with_job(args[0], fn)


