#!/usr/bin/env -S uv run --quiet --python 3 --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["playwright==1.63.0", "axe-playwright-python==0.1.8"]
# ///
"""Headless screenshots + basic checks of a running app, for the ui/ux reviewers.

  .factory/shoot <base-url> --out <dir> [--path /] [--path /x] [--widths 375,1280]
                 [--scheme light|dark|both] [--wait 1500] [--axe]
                 [--serve "<server command>" [--serve-port N|auto] [--serve-cwd <dir>]
                  [--serve-ready /path] [--serve-env K=V]… [--serve-timeout 120]]

Per path × width (× colour scheme): <dir>/<slug>-<width>[-dark].png (full page).
<dir>/shoot.json holds per shot: status, title, console errors, page errors, failed
requests, horizontal overflow and a11y counts (img without alt, form fields without a
label, buttons/links without a name). `--axe` also runs axe-core (WCAG 2.x A/AA rules, bundled with
axe-playwright-python, no network) per shot: `axe` in shoot.json lists each violated rule with its
impact, help text and the number of nodes (and the first selectors).
Refuses more than --max-shots (default 12, never more than 24) shots per call. A page that
never goes network-idle (long polling, websockets) is shot after "load" instead of failing;
full-page shots stop at 8000 px height (shoot.json says when a page was cut).
Exit code 1 if a page does not load (no response or status >= 400).
With `--serve`, shoot starts the app itself through `.factory/serve-with` (same directory): the
server runs only for this call and is always stopped afterwards, also on a failure or Ctrl-C.
`{port}` in the server command and in <base-url> is the server's port (`--serve-port`, default
`auto` = a free port, so parallel jobs never collide), e.g.
  .factory/shoot 'http://localhost:{port}' --serve 'npm run dev -- --port {port}' --serve-cwd <Worktree> --out <dir>
Without `--serve`, shoot photographs an app that is already running.
No browser yet: `uv run --no-project --python 3 --with playwright==1.63.0 playwright install chromium`.
`--python 3` keeps uv from following the repo's .python-version pin.
"""
import argparse, json, os, re, sys

CHECKS = """() => {
  const named = el => (el.getAttribute('aria-label') || el.getAttribute('aria-labelledby')
    || el.getAttribute('title') || el.textContent || '').trim().length > 0;
  const labelled = el => el.labels?.length > 0 || el.getAttribute('aria-label')
    || el.getAttribute('aria-labelledby') || el.getAttribute('title');
  const fields = [...document.querySelectorAll('input, select, textarea')]
    .filter(el => !['hidden', 'submit', 'button', 'reset'].includes(el.type));
  return {
    overflow_x: document.documentElement.scrollWidth > window.innerWidth + 1,
    scroll_width: document.documentElement.scrollWidth,
    img_no_alt: document.querySelectorAll('img:not([alt])').length,
    field_no_label: fields.filter(el => !labelled(el)).length,
    control_no_name: [...document.querySelectorAll('button, a[href], [role=button]')]
      .filter(el => !named(el) && !el.querySelector('img[alt]:not([alt=""])')).length,
  };
}"""

MAX_HEIGHT = 8000
HARD_MAX_SHOTS = 24

def slug(path):
    return re.sub(r"[^a-z0-9]+", "-", path.lower()).strip("-") or "root"

def axe_source():
    import axe_playwright_python
    with open(os.path.join(os.path.dirname(axe_playwright_python.__file__), "axe.min.js")) as f:
        return f.read()

AXE_RUN = """async () => {
  const r = await axe.run(document, {runOnly: {type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa']},
                                     resultTypes: ['violations']});
  return r.violations.map(v => ({id: v.id, impact: v.impact, help: v.help, nodes: v.nodes.length,
                                 targets: v.nodes.slice(0, 3).map(n => n.target.join(' '))}));
}"""

def run_axe(page, src):
    try:
        page.add_script_tag(content=src)
        return page.evaluate(AXE_RUN)
    except Exception as e:  # a strict CSP can refuse the injected script
        return {"error": str(e).splitlines()[0][:300]}

def shoot(page, url, out, name, wait, axe=None):
    rec = {"url": url, "shot": None, "status": None, "console_errors": [],
           "page_errors": [], "failed_requests": []}
    page.on("console", lambda m: m.type == "error" and rec["console_errors"].append(m.text[:300]))
    page.on("pageerror", lambda e: rec["page_errors"].append(str(e)[:300]))
    page.on("requestfailed", lambda r: rec["failed_requests"].append(f"{r.method} {r.url} {r.failure}"))
    page.on("response", lambda r: r.status >= 400 and rec["failed_requests"].append(f"{r.status} {r.url}"))
    try:
        resp = page.goto(url, wait_until="load", timeout=30000)
    except Exception as e:  # timeout or no connection
        rec["error"] = str(e).splitlines()[0]
        return rec
    try:
        page.wait_for_load_state("networkidle", timeout=10000)
    except Exception:  # long polling / websockets never go idle: shoot what loaded
        rec["not_network_idle"] = True
    page.wait_for_timeout(wait)
    rec["status"] = resp.status if resp else None
    rec["title"] = page.title()
    rec.update(page.evaluate(CHECKS))
    if axe:
        rec["axe"] = run_axe(page, axe)
    rec["shot"] = os.path.join(out, name + ".png")
    height = page.evaluate("() => document.documentElement.scrollHeight")
    if height > MAX_HEIGHT:
        rec["cut_at_px"] = MAX_HEIGHT
        page.screenshot(path=rec["shot"], full_page=True,
                        clip={"x": 0, "y": 0, "width": page.viewport_size["width"], "height": MAX_HEIGHT})
    else:
        page.screenshot(path=rec["shot"], full_page=True)
    return rec

SERVE_OPTS = {"--serve": "--server", "--serve-port": "--port", "--serve-cwd": "--cwd",
              "--serve-ready": "--ready", "--serve-env": "--env", "--serve-timeout": "--timeout"}

def serve_argv(argv, me=None):
    """With --serve: the serve-with command line that runs this shoot call (without the --serve
    options) while the server is up. Without --serve: None."""
    rest, opts = [], {"--serve-port": ["auto"], "--serve-ready": ["/"]}
    i = 0
    while i < len(argv):
        a = argv[i]
        key, _, val = a.partition("=")
        if key in SERVE_OPTS:
            if not val:
                if i + 1 >= len(argv):
                    sys.exit(f"shoot: {a} needs a value")
                val, i = argv[i + 1], i + 1
            if key == "--serve-env":
                opts.setdefault(key, []).append(val)
            else:
                opts[key] = [val]
        else:
            rest.append(a)
        i += 1
    if "--serve" not in opts:
        return None
    here = os.path.dirname(os.path.abspath(__file__))
    out = [os.path.join(here, "serve-with"), "--timeout", opts.pop("--serve-timeout", ["120"])[0],
           "--server", opts.pop("--serve")[0]]
    for key, vals in opts.items():
        for v in vals:
            out += [SERVE_OPTS[key], v]
    return out + ["--"] + (me or [sys.executable, os.path.abspath(__file__)]) + rest

def main():
    wrapped = serve_argv(sys.argv[1:])
    if wrapped:
        os.execv(wrapped[0], wrapped)
    from playwright.sync_api import sync_playwright
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("base")
    ap.add_argument("--out", required=True)
    ap.add_argument("--path", action="append", default=[])
    ap.add_argument("--widths", default="375,1280")
    ap.add_argument("--scheme", choices=["light", "dark", "both"], default="light")
    ap.add_argument("--wait", type=int, default=1500, help="ms after networkidle (e.g. Streamlit)")
    ap.add_argument("--max-shots", type=int, default=12, help="refuse more shots than this per call")
    ap.add_argument("--axe", action="store_true", help="run axe-core (WCAG A/AA) per shot, into shoot.json")
    ap.add_argument("--serve", help="start the app with this command for this call (.factory/serve-with)")
    a = ap.parse_args()
    os.makedirs(a.out, exist_ok=True)
    widths = [int(w) for w in a.widths.split(",")]
    schemes = ["light", "dark"] if a.scheme == "both" else [a.scheme]
    n = len(a.path or ["/"]) * len(widths) * len(schemes)
    if n > min(a.max_shots, HARD_MAX_SHOTS):
        sys.exit(f"shoot: {n} shots requested, limit is {min(a.max_shots, HARD_MAX_SHOTS)} (--max-shots, at most {HARD_MAX_SHOTS}). Photograph only the "
                 f"pages the diff changes: fewer paths, widths or colour schemes.")
    results = []
    axe = axe_source() if a.axe else None
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        for scheme in schemes:
            for w in widths:
                ctx = browser.new_context(viewport={"width": w, "height": 900}, color_scheme=scheme)
                for path in a.path or ["/"]:
                    name = f"{slug(path)}-{w}" + ("-dark" if scheme == "dark" else "")
                    page = ctx.new_page()
                    rec = shoot(page, a.base.rstrip("/") + path, a.out, name, a.wait, axe)
                    rec.update(width=w, scheme=scheme)
                    results.append(rec)
                    page.close()
                ctx.close()
        browser.close()
    with open(os.path.join(a.out, "shoot.json"), "w") as f:
        json.dump(results, f, indent=2, ensure_ascii=False)
    bad = 0
    for r in results:
        ok = r["shot"] and r["status"] and r["status"] < 400
        bad += not ok
        flags = [k for k in ("console_errors", "page_errors", "failed_requests") if r[k]]
        flags += [k for k in ("overflow_x",) if r.get(k)]
        flags += [f"{k}={r[k]}" for k in ("img_no_alt", "field_no_label", "control_no_name") if r.get(k)]
        if isinstance(r.get("axe"), list) and r["axe"]:
            flags.append("axe=" + ",".join(f"{v['id']}({v['impact']})" for v in r["axe"][:5])
                         + (f"+{len(r['axe']) - 5}" if len(r["axe"]) > 5 else ""))
        elif isinstance(r.get("axe"), dict):
            flags.append("axe-error")
        print(f"{'ok ' if ok else 'ERR'} {r['status'] or '-':>3} {r['width']:>5} {r['scheme']:<5} "
              f"{r['url']}  {r.get('error') or ' '.join(flags) or 'clean'}")
    print(f"→ {os.path.join(a.out, 'shoot.json')}")
    sys.exit(1 if bad else 0)

if __name__ == "__main__":
    main()
