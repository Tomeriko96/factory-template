def hold_main(job_id):
    """`--hold <job-id>`: the hold-class files in the job's diff, one `<class>: <file>` per line."""
    with open(os.path.join(HERE, "jobs", job_id, "job.json")) as f:
        job = json.load(f)
    wt, base, branch = job.get("worktree"), job.get("base"), job.get("branch")
    names = git("diff", "--name-only", "--no-renames", "-z", f"{diff_base(job)}...{branch}", cwd=wt) \
        if wt and base and branch else None
    if names is None:
        sys.exit("cannot diff the job branch")
    extra = extra_hold_globs()
    for name in filter(None, names.split("\0")):
        cls = hold_class(name, extra)
        if cls:
            print(f"{cls}: {name}")


def validate_commands():
    """The commands of the "Validate" block of repo.md: the first backticked command of each
    `- ` line under the `- Validate (…):` line (or backticked on that line itself)."""
    try:
        lines = open(os.path.join(HERE, "repo.md"), errors="replace").read().splitlines()
    except OSError:
        return []
    cmds, inside = [], False
    for line in lines:
        head = re.match(r"^\s*-\s*Validate\b(.*)$", line)
        if head:
            if "docs-only" in head.group(1):
                inside = False
                continue
            inside = True
            rest = re.sub(r"\([^)]*\)", "", head.group(1))   # "(… run as `heavy --cache -- <command>` …)"
            rest = rest.split(":", 1)[1] if ":" in rest else ""
            cmds += [c for c in re.findall(r"`([^`]+)`", rest) if not c.startswith("<")]
            continue
        if inside:
            sub = re.match(r"^\s+[-*]\s+`([^`]+)`", line)
            if sub:
                cmds.append(sub.group(1))
            elif line.strip() and not line.startswith((" ", "\t")):
                inside = False
    return [c for c in cmds if "heavy" not in c.split()[:1]]


