#!/usr/bin/env python3
"""Mechanical checks before the approver, so it only has to judge.

  .factory/precheck <job-id> [<round>]
  .factory/precheck --hold <job-id>     only list the files of the job's diff that sit in a class
                                        CI alone does not vouch for (`<class>: <file>` per line);
                                        .factory/job uses it to lift a `light` job to `full`

Reads .factory/jobs/<job-id>/ (job.json, spec.md, round-N/*) and the job branch's diff
against its base, writes <job>/precheck.md and prints it. First line is
`PRECHECK: CLEAN` or `PRECHECK: ISSUES`; exit 0 either way (the orchestrator reads the line).
For a `"mode": "docs"` job there are no reviews: instead build.md must contain a `## PR`
section and every changed file must be a documentation path (`limits.docs_globs` in
config.json, default below); if that is the only problem the first line is
`PRECHECK: NOT-DOCS` so the orchestrator can fall back to the light review.

Checks (each failing one is listed under Issues):
  - round-N/build.md exists, and spec.md too (not in docs mode: there the feature text is the spec)
  - the latest review of every reviewer (from round 2 on only some re-run) starts with `VERDICT: PASS`
  - audit table: no row marked ❌ or ⏭️ (a ⚠️ row is listed as a note, not an issue)
  - the diff touches nothing under .factory/ or .claude/
  - no secret-looking files (.env, keys, certificates, credentials, *.sops.* decrypted copies)
  - no secret-looking content in added lines (tokens, private keys); only the file and kind are shown
  - the diff is not huge (> 40 files or > 1500 changed lines) and has no binary or > 1 MB file
Renames are diffed as delete + add, so a file moved to `.env` or into .factory/ is still seen.

Second line of the output: `AUTO-MERGE: yes` or `AUTO-MERGE: no: <reasons>`. The mechanical half
of the auto-merge gate (.factory/job adds the rest): no issues, no audit deviation (⚠️), and no
file in a class that CI alone does not vouch for (CI/pipeline config, dependencies and
lockfiles, containers, schema and migrations, auth), plus whatever `delivery.auto_merge_never`
in config.json lists (globs; put personal-data paths there).
Also reported: files, lines, commits, [blocking] mentions per review (information only).
"""
import fnmatch, json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))  # <repo>/.factory
SECRET = re.compile(r"(^|/)(\.env(?!\.(example|sample|template|dist)$)(\..*)?|id_(rsa|ed25519|ecdsa)|"
                    r".*\.(pem|key|p12|pfx|jks|kdbx)|credentials(\.json)?|.*secrets?.*\.(ya?ml|json|toml)|"
                    r"service[-_]?account.*\.json|\.git-credentials|\.netrc|\.pgpass)$", re.I)
SECRET_CONTENT = [
    ("private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("GitHub token", re.compile(r"\b(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})")),
    ("GitLab token", re.compile(r"\bglpat-[A-Za-z0-9_-]{20,}")),
    ("AWS access key", re.compile(r"\b(AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("Anthropic/OpenAI key", re.compile(r"\bsk-(ant-)?[A-Za-z0-9_-]{32,}")),
    ("Slack token", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
]
# No "*.txt": requirements.txt and other config would pass as documentation
DOCS_GLOBS = ["*.md", "*.mdx", "*.rst", "*.adoc", "docs/**", "LICENSE*", "mkdocs.yml"]
MAX_FILES, MAX_LINES, MAX_BYTES = 40, 1500, 1_000_000
# Files where a green CI is not enough to merge unseen. A glob with a "/" is matched against the
# whole path (with a leading "/", so "*/auth/*" also matches a top-level auth/), one without
# against the file name.
HOLD_CLASSES = {
    "CI/pipeline config": ["*/.github/*", "*/.gitlab-ci.yml", "*/.gitlab/*", "*/.circleci/*", "Jenkinsfile",
                           "azure-pipelines.yml", ".pre-commit-config.yaml"],
    "dependencies": ["package.json", "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "pyproject.toml",
                     "uv.lock", "poetry.lock", "requirements*.txt", "Pipfile", "Pipfile.lock", "go.mod",
                     "go.sum", "Cargo.toml", "Cargo.lock", "Gemfile", "Gemfile.lock", "composer.json",
                     "composer.lock", "renv.lock", "DESCRIPTION"],
    "container/deploy": ["Dockerfile*", "docker-compose*.y*ml", "compose*.y*ml", "*/helm/*", "*/charts/*",
                         "*/k8s/*", "*/kubernetes/*", "*/terraform/*", "*.tf"],
    "schema/migrations": ["*/migrations/*", "*/alembic/*", "*.sql", "*/schema/*", "schema.*"],
    "auth": ["*/auth/*", "*/authn/*", "*/authz/*", "*/oauth*", "*/oidc*", "*/sso*", "*/saml*", "*/rbac*",
             "*/permissions*", "*/login*", "*/secrets/*"],
}


def hold_class(name, extra):
    path = "/" + name
    for cls, globs in [*HOLD_CLASSES.items(), ("delivery.auto_merge_never", extra)]:
        for g in globs:
            if "/" in g:
                hit = fnmatch.fnmatch(path, g) or fnmatch.fnmatch(name, g) or \
                    (g.endswith("/**") and name.startswith(g[:-2].lstrip("*/")))
            else:
                hit = fnmatch.fnmatch(os.path.basename(name), g)
            if hit:
                return cls
    return None


def git(*args, cwd):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


def is_doc(name, globs):
    for g in globs:
        if g.endswith("/**"):
            if name.startswith(g[:-2]):
                return True
        elif fnmatch.fnmatch(name, g) or fnmatch.fnmatch(os.path.basename(name), g):
            return True
    return False


def first_line(path):
    try:
        with open(path, errors="replace") as f:
            return f.readline().strip()
    except OSError:
        return None


def extra_hold_globs():
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            return [g for g in ((json.load(f).get("delivery") or {}).get("auto_merge_never") or [])
                    if isinstance(g, str)]
    except (OSError, ValueError):
        return []


def hold_main(job_id):
    """`--hold <job-id>`: the hold-class files in the job's diff, one `<class>: <file>` per line."""
    with open(os.path.join(HERE, "jobs", job_id, "job.json")) as f:
        job = json.load(f)
    wt, base, branch = job.get("worktree"), job.get("base"), job.get("branch")
    names = git("diff", "--name-only", "--no-renames", "-z", f"{base}...{branch}", cwd=wt) if wt and base and branch else None
    if names is None:
        sys.exit("cannot diff the job branch")
    extra = extra_hold_globs()
    for name in filter(None, names.split("\0")):
        cls = hold_class(name, extra)
        if cls:
            print(f"{cls}: {name}")


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    if sys.argv[1] == "--hold":
        if len(sys.argv) != 3:
            sys.exit(__doc__)
        return hold_main(sys.argv[2])
    job_id = sys.argv[1]
    job_dir = os.path.join(HERE, "jobs", job_id)
    with open(os.path.join(job_dir, "job.json")) as f:
        job = json.load(f)
    rnd = int(sys.argv[2]) if len(sys.argv) > 2 else int(job.get("round") or 1)
    rdir = os.path.join(job_dir, f"round-{rnd}")
    wt, base, branch = job.get("worktree"), job.get("base"), job.get("branch")
    issues, notes, not_docs = [], [], []
    docs_mode = job.get("mode") == "docs"
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            globs = (json.load(f).get("limits") or {}).get("docs_globs") or DOCS_GLOBS
    except (OSError, ValueError):
        globs = DOCS_GLOBS

    extra_hold = extra_hold_globs()
    hold = {}  # file -> class

    required = [os.path.join(rdir, "build.md")] + ([] if docs_mode else [os.path.join(job_dir, "spec.md")])
    for p in required:
        if not os.path.exists(p):
            issues.append(f"missing {os.path.relpath(p, job_dir)}")

    # Latest verdict per reviewer across rounds: from round 2 on only some reviewers re-run
    latest = {}
    for r in range(1, rnd + 1):
        d = os.path.join(job_dir, f"round-{r}")
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if f.startswith("review-") and f.endswith(".md"):
                latest[f] = (r, os.path.join(d, f))
    reviews = sorted(latest)
    if docs_mode:
        build = os.path.join(rdir, "build.md")
        if os.path.exists(build) and not re.search(r"^## PR\b", open(build, errors="replace").read(), re.M):
            issues.append("build.md has no '## PR' section")
    elif not reviews:
        issues.append(f"no reviews in round-{rnd}")
    info = []
    for f in reviews:
        r, path = latest[f]
        fl = first_line(path) or ""
        if fl != "VERDICT: PASS":
            issues.append(f"{f} (round {r}): first line is {fl!r}, not 'VERDICT: PASS'")
        text = open(path, errors="replace").read()
        info.append(f"{f[7:-3]} {text.count('[blocking]')}b/{text.count('[non-blocking]')}nb" + (f" (r{r})" if r != rnd else ""))

    audit = latest.get("review-audit.md", (0, ""))[1]
    if audit and os.path.exists(audit):
        for line in open(audit, errors="replace"):
            if line.lstrip().startswith("|") and "---" not in line:
                if "❌" in line or "⏭" in line:
                    issues.append("audit row not confirmed: " + re.sub(r"\s+", " ", line.strip())[:140])
                elif "⚠" in line:
                    notes.append("audit deviation: " + re.sub(r"\s+", " ", line.strip())[:140])

    files = lines = 0
    commits = "?"
    if wt and base and branch and os.path.isdir(wt):
        numstat = git("diff", "--numstat", "--no-renames", "-z", f"{base}...{branch}", cwd=wt)
        if numstat is None:
            issues.append(f"cannot diff {base}...{branch} in {wt}")
        else:
            for row in filter(None, numstat.split("\0")):
                a, d, name = row.split("\t", 2)
                files += 1
                if a == "-":
                    issues.append(f"binary file in diff: {name}")
                else:
                    lines += int(a) + int(d)
                if docs_mode and not is_doc(name, globs):
                    not_docs.append(name)
                if name.startswith((".factory/", ".claude/")):
                    issues.append(f"factory/claude file in diff: {name}")
                if SECRET.search(name):
                    issues.append(f"secret-looking file in diff: {name}")
                cls = hold_class(name, extra_hold)
                if cls:
                    hold[name] = cls
                size = git("cat-file", "-s", f"{branch}:{name}", cwd=wt)
                if size and size.strip().isdigit() and int(size) > MAX_BYTES:
                    issues.append(f"file over 1 MB in diff: {name}")
            if files > MAX_FILES or lines > MAX_LINES:
                issues.append(f"large diff: {files} files, {lines} changed lines")
            found = set()
            patch = git("diff", "--no-renames", "--no-color", "--no-ext-diff", "-U0",
                        f"{base}...{branch}", cwd=wt) or ""
            name = None
            for line in patch.splitlines():
                if line.startswith("+++ "):
                    # "+++ b/x", or quoted ("+++ \"b/x\"") for unusual names; /dev/null = deleted
                    raw = line[4:].strip('"')
                    name = None if raw == "/dev/null" else raw[2:] if raw.startswith("b/") else raw
                elif name and line.startswith("+"):
                    for kind, rx in SECRET_CONTENT:
                        if rx.search(line):
                            found.add((name, kind))
            for name, kind in sorted(found):
                issues.append(f"secret-looking content in diff ({kind}): {name}")
        commits = (git("rev-list", "--count", f"{base}..{branch}", cwd=wt) or "?").strip()
    else:
        issues.append("worktree, base or branch missing in job.json / on disk")

    if not_docs:
        issues.append("not documentation: " + ", ".join(not_docs[:8]) + (" …" if len(not_docs) > 8 else ""))
    verdict = "CLEAN" if not issues else "NOT-DOCS" if docs_mode and len(issues) == 1 and not_docs else "ISSUES"
    why = []
    if verdict != "CLEAN":
        why.append(f"precheck {verdict}")
    if any(n.startswith("audit deviation") for n in notes):
        why.append("audit has a deviation (⚠️)")
    for cls in sorted(set(hold.values())):
        names = sorted(n for n, c in hold.items() if c == cls)
        why.append(f"touches {cls}: " + ", ".join(names[:3]) + (" …" if len(names) > 3 else ""))
    out = [f"PRECHECK: {verdict}", "AUTO-MERGE: " + ("no: " + "; ".join(why) if why else "yes"), "",
           f"Job {job_id}, round {rnd}: {files} files, {lines} changed lines, {commits} commits.",
           "Reviews: " + (", ".join(info) or "none"), "", "## Issues"]
    out += [f"- {i}" for i in issues] or ["None."]
    out += ["", "## Notes"] + ([f"- {n}" for n in notes] or ["None."])
    text = "\n".join(out) + "\n"
    with open(os.path.join(job_dir, "precheck.md"), "w") as f:
        f.write(text)
    print(text, end="")


if __name__ == "__main__":
    main()
