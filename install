#!/usr/bin/env bash
# Install the factory into a git repo, local-only: nothing is ever committed.
#
#   install [<repo>]            install or update (default: current directory); without
#                               <repo> and without a config, then starts /factory setup
#   install --no-setup [<repo>] install or update only
#   install --remove [<repo>]   remove it again; keeps your data (.factory/config.json,
#                               repo.md, backlog.md, jobs/), still git-excluded, so a
#                               re-install continues where it was. Refuses while jobs are
#                               unfinished; stops servers and removes clean job worktrees
#   install --remove --purge [<repo>]   also delete that data
#   install --link              put `factory-init` on PATH (~/.local/bin symlink)
#
# Files go to .claude/skills/factory/, .claude/agents/factory-*.md and .factory/, and are
# excluded via .git/info/exclude (not .gitignore, so not even that is committed).
# Update = re-run: generic files are replaced; .factory/config.json, repo.md,
# backlog.md and jobs/ are kept. Afterwards: claude → /factory setup.
set -euo pipefail

TEMPLATE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
SRC="$TEMPLATE/template"
PATTERNS=("/.factory/" "/.claude/skills/factory/" "/.claude/agents/factory-*.md" "/.claude/settings.local.json")
SCRIPTS=(shoot serve watch heavy guard precheck rereview ci job)

die() { echo "factory: $*" >&2; exit 1; }

remove=0 purge=0 setup=1 target="."
for a in "$@"; do
  case "$a" in
    --remove) remove=1 ;;
    --purge) purge=1 ;;
    --no-setup) setup=0 ;;
    --link)
      mkdir -p "$HOME/.local/bin"
      ln -sfn "$TEMPLATE/install" "$HOME/.local/bin/factory-init"
      ln -sfn "$TEMPLATE/template/.factory/watch" "$HOME/.local/bin/factory-watch"
      echo "linked $HOME/.local/bin/factory-init -> $TEMPLATE/install"
      echo "linked $HOME/.local/bin/factory-watch -> one board for every repo the factory is installed in"
      case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "note: ~/.local/bin is not on PATH" ;; esac
      exit 0 ;;
    -h|--help) sed -n '2,17p' "$TEMPLATE/install" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $a" ;;
    *) target="$a"; setup=0 ;;
  esac
done
(( ! purge || remove )) || die "--purge only goes with --remove"

repo="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo: $target"
common="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)"
[ "$common" = "$(git -C "$repo" rev-parse --path-format=absolute --git-dir)" ] \
  || die "run this in the main checkout, not in a linked worktree"
[ "$repo" != "$TEMPLATE" ] || die "refusing to install into the template repo itself"
exclude="$common/info/exclude"

# Add (hook=1) or remove (hook=0) the guard in <repo>/.claude/settings.local.json, keeping
# everything else in that file. The entry is recognised by ".factory/guard" in its command.
settings_hook() {
  python3 - "$1" "$2" <<'PY'
import json, os, sys
repo, add = sys.argv[1], sys.argv[2] == "1"
path = os.path.join(repo, ".claude", "settings.local.json")
cmd = '"$CLAUDE_PROJECT_DIR"/.factory/guard --subagents-only'
try:
    cfg = json.load(open(path))
except FileNotFoundError:
    cfg = {}
except ValueError:
    print(f"note: {path} is not valid JSON; not touching it (the guard hook for ad-hoc subagents "
          f"is {'not set up' if add else 'left in it'})", file=sys.stderr)
    sys.exit(0)
pre = cfg.setdefault("hooks", {}).setdefault("PreToolUse", [])
def ours(e):
    return any(".factory/guard" in h.get("command", "") for h in e.get("hooks", []))
pre[:] = [e for e in pre if not ours(e)]
if add:
    pre.append({"matcher": "Bash", "hooks": [{"type": "command", "command": cmd}]})
if not pre:
    del cfg["hooks"]["PreToolUse"]
if not cfg.get("hooks"):
    cfg.pop("hooks", None)
if cfg:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(cfg, open(path, "w"), indent=2)
    open(path, "a").write("\n")
elif os.path.exists(path):
    os.remove(path)
PY
}

# The list of repos the factory is installed in, for `factory-watch` (one board for all)
REGISTRY="${FACTORY_REPOS_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/factory/repos}"
register() {    # register <repo> 1|0
  mkdir -p "$(dirname "$REGISTRY")"
  touch "$REGISTRY"
  grep -vxF -- "$1" "$REGISTRY" > "$REGISTRY.tmp" || true
  if [ "$2" = 1 ]; then echo "$1" >> "$REGISTRY.tmp"; fi
  mv "$REGISTRY.tmp" "$REGISTRY"
}

strip_block() {
  [ -f "$exclude" ] && sed -i '/^# factory:begin/,/^# factory:end/d' "$exclude" || true
}

# Jobs that are not at rest, as "id:stage" words (reads the top-level stage, not history)
unfinished_jobs() {
  python3 - "$1" <<'PY'
import glob, json, os, sys
done = {"merged", "pushed", "pr-open", "superseded"}
for p in sorted(glob.glob(os.path.join(sys.argv[1], ".factory", "jobs", "*", "job.json"))):
    jid = os.path.basename(os.path.dirname(p))
    try:
        job = json.load(open(p))
        stage = job.get("stage") if isinstance(job, dict) else None
    except (OSError, ValueError):
        stage, job = "unreadable", {}
    if stage not in done or (isinstance(job, dict) and job.get("syncing")):
        print(f"{jid}:{stage}{'+sync' if isinstance(job, dict) and job.get('syncing') else ''}")
PY
}

if (( remove )); then
  open_jobs="$(unfinished_jobs "$repo" | tr '\n' ' ')"
  [ -z "$open_jobs" ] || die "unfinished jobs: $open_jobs
Finish them (/factory approve|rework, or .factory/job fail <id> to park one) or delete their folders first."
  # servers that serve started (it leaves a reused process id alone)
  [ -x "$repo/.factory/serve" ] && { "$repo/.factory/serve" stop-all || echo "note: some servers did not stop; see .factory/serve status"; }
  # job worktrees: remove the clean ones, keep and list the rest
  wtdir="$(dirname "$repo")/$(basename "$repo")-worktrees"
  kept_wt=""
  while IFS= read -r wt; do
    case "$wt" in "$wtdir"/*) git -C "$repo" worktree remove "$wt" 2>/dev/null || kept_wt+="  $wt"$'\n' ;; esac
  done < <(git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p')
  git -C "$repo" worktree prune
  rmdir "$wtdir" 2>/dev/null || true
  if [ -z "$(git -C "$repo" ls-files -- .claude/settings.local.json)" ]; then
    settings_hook "$repo" 0
  fi
  rm -rf "$repo/.claude/skills/factory"
  rm -f "$repo"/.claude/agents/factory-*.md
  rmdir "$repo/.claude/skills" "$repo/.claude/agents" "$repo/.claude" 2>/dev/null || true
  strip_block
  if (( purge )); then
    rm -rf "$repo/.factory"
  else
    for f in "${SCRIPTS[@]}" VERSION; do rm -f "$repo/.factory/$f"; done
    rm -rf "$repo/.factory/run" "$repo/.factory/cache"
    rm -f "$repo/.factory/jobs/.lock"
    rmdir "$repo/.factory/jobs" "$repo/.factory" 2>/dev/null || true
    if [ -d "$repo/.factory" ]; then
      # the kept data must stay invisible to git
      { echo "# factory:begin (kept data of a removed factory; install --remove --purge deletes it)"
        echo "/.factory/"
        echo "# factory:end"; } >> "$exclude"
      git -C "$repo" check-ignore -q .factory/x || echo "warning: .factory/ is not ignored by git; do not commit it"
    fi
  fi
  register "$repo" 0
  echo "factory removed from $repo"
  if [ -d "$repo/.factory" ]; then
    echo "kept (git-excluded): $(cd "$repo/.factory" && ls -A | tr '\n' ' ')— a re-install continues with it; --remove --purge deletes it"
  fi
  [ -z "$kept_wt" ] || printf 'worktrees kept (uncommitted changes; remove by hand):\n%s' "$kept_wt"
  branches="$(git -C "$repo" branch --list 'factory/*' --format='%(refname:short)' | tr '\n' ' ')"
  [ -z "$branches" ] || echo "local job branches left (pushed ones live on the remote too): $branches— delete with git branch -D <name>"
  exit 0
fi

tracked="$(git -C "$repo" ls-files -- .factory .claude/skills/factory '.claude/agents/factory-*.md')"
[ -z "$tracked" ] || die "these paths are tracked in git, so a local-only install is impossible:
$tracked"
# settings.local.json is optional: if the repo tracks it, leave it alone (agents still have the
# guard in their frontmatter; only ad-hoc subagents are then not covered)
settings_ok=1
[ -z "$(git -C "$repo" ls-files -- .claude/settings.local.json)" ] || settings_ok=0

# exclude first, so the files never show up as untracked
mkdir -p "$(dirname "$exclude")"
strip_block
{
  echo "# factory:begin (local-only, managed by factory-template/install)"
  printf '%s\n' "${PATTERNS[@]}"
  echo "# factory:end"
} >> "$exclude"

mkdir -p "$repo/.claude/skills" "$repo/.claude/agents" "$repo/.factory/jobs"
rm -rf "$repo/.claude/skills/factory"
cp -R "$SRC/.claude/skills/factory" "$repo/.claude/skills/factory"
rm -f "$repo"/.claude/agents/factory-*.md
cp "$SRC"/.claude/agents/factory-*.md "$repo/.claude/agents/"
for f in "${SCRIPTS[@]}"; do
  cp "$SRC/.factory/$f" "$repo/.factory/$f"
  chmod +x "$repo/.factory/$f"
done
if (( settings_ok )); then
  settings_hook "$repo" 1
else
  echo "note: .claude/settings.local.json is tracked here; the guard hook for ad-hoc subagents was not added"
fi
[ -f "$repo/.factory/backlog.md" ] || cp "$SRC/.factory/backlog.md" "$repo/.factory/"
git -C "$TEMPLATE" describe --tags --always --dirty > "$repo/.factory/VERSION" 2>/dev/null \
  || echo unknown > "$repo/.factory/VERSION"

# verify: everything ignored, nothing visible to git
for p in .factory/VERSION .claude/skills/factory/SKILL.md .claude/agents/factory-builder.md; do
  git -C "$repo" check-ignore -q "$p" \
    || die "$p is NOT ignored by git (a .gitignore negation?). Run: install --remove"
done
leak="$(git -C "$repo" status --porcelain --untracked-files=all -- .factory .claude | grep -E 'factory' || true)"
[ -z "$leak" ] || die "git still sees factory files:
$leak"

register "$repo" 1
echo "factory $(cat "$repo/.factory/VERSION") installed in $repo (local-only, git-excluded)"
if [ -f "$repo/.factory/config.json" ]; then
  echo "config kept; run /factory setup again only to re-tailor"
elif (( setup )) && [ -t 0 ] && command -v claude >/dev/null; then
  echo "starting claude (opus) with /factory setup …"
  cd "$repo" && exec claude --model opus "/factory setup"
else
  echo "next: start claude in the repo and run /factory setup"
fi
