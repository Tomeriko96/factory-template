#!/usr/bin/env python3
"""Factory board: shows every job in .factory/jobs/*/job.json.

  .factory/watch          live board (refreshes every 2s, ctrl-c stops)
  .factory/watch --once   print once and exit
  .factory/watch --tmux   open the board in a split pane at the bottom (inside tmux)
  .factory/watch <job-id> detail: files in the job folder + first lines of decision.md
                          + CI/CD stages/jobs (via .factory/ci cache)
  .factory/watch --no-ci  skip CI/CD lines (no `gh`/`glab` calls at all)
Unknown keys in job.json are ignored; missing fields show '-'.
CI state comes from .factory/cache/ci-<job-id>.json (written by .factory/ci);
watch refreshes stale entries (TTL 30s) in the background of each loop.
"""
import json, os, subprocess, sys, time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))  # <repo>/.factory

def load(jobs_dir):
    jobs = []
    if not os.path.isdir(jobs_dir):
        return jobs
    for name in sorted(os.listdir(jobs_dir)):
        p = os.path.join(jobs_dir, name, "job.json")
        try:
            with open(p) as f:
                j = json.load(f)
        except (OSError, ValueError):
            continue
        j.setdefault("id", name)
        jobs.append(j)
    return jobs

def age(iso):
    try:
        t = datetime.fromisoformat(iso.replace("Z", "+00:00"))
        s = int((datetime.now(timezone.utc) - t).total_seconds())
        return f"{s//3600}h{s%3600//60:02d}m" if s >= 3600 else f"{s//60}m{s%60:02d}s"
    except Exception:
        return "-"

ACTIVE = ("spec", "build", "review", "approve")

def header(jobs):
    """One line: machine load and active jobs against the cap (limits in config.json)."""
    try:
        load = float(open("/proc/loadavg").read().split()[0])
    except (OSError, ValueError):
        load = os.getloadavg()[0]
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            cap = (json.load(f).get("limits") or {}).get("active_jobs", 3)
    except (OSError, ValueError):
        cap = 3
    try:
        with open(os.path.join(HERE, "config.json")) as f:
            pr_cap = (json.load(f).get("limits") or {}).get("open_prs", 5)
    except (OSError, ValueError):
        pr_cap = 5
    act = sum(1 for j in jobs if j.get("stage") in ACTIVE)
    queued = sum(1 for j in jobs if j.get("stage") == "queued")
    prs = [j for j in jobs if j.get("stage") == "pr-open"]
    line = f"load {load:.1f} on {os.cpu_count()} cores · active jobs {act}/{cap}"
    if prs:
        since = [h["at"] for j in prs for h in (j.get("history") or []) if h.get("stage") == "pr-open"][-len(prs):]
        failing = sum(1 for j in prs if (j.get("pr_state") or {}).get("pipeline") == "failed")
        line += (f" · PRs open {len(prs)}" + (f"/{pr_cap}" if pr_cap else "") +
                 (f", oldest {age(min(since))}" if since else "") +
                 (f", {failing} failing" if failing else ""))
    return line + (f" · {queued} queued" if queued else "")

COL = {"queued": "\033[2m", "needs-human": "\033[1;31m", "merged": "\033[32m", "pr-open": "\033[32m", "pushed": "\033[32m", "review": "\033[33m",
       "build": "\033[36m", "approve": "\033[35m", "spec": "\033[34m"}

def paint(text, stage):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"{COL.get(stage, '')}{text}\033[0m"

def detail(jobs_dir, job_id):
    d = os.path.join(jobs_dir, job_id)
    if not os.path.isdir(d):
        return f"no job '{job_id}'"
    out = [f"== {job_id}"]
    for dp, _, fs in sorted(os.walk(d)):
        for f in sorted(fs):
            out.append("  " + os.path.relpath(os.path.join(dp, f), d))
    for f in ("decision.md",):
        p = os.path.join(d, f)
        if os.path.exists(p):
            out += ["", f"-- {f}"] + open(p).read().splitlines()[:12]
    out += ["", "-- CI/CD"] + ci_detail_lines(job_id)
    return "\n".join(out)

CI_SYM = {"success": "✓", "failed": "✗", "running": "●", "pending": "○",
          "canceled": "-", "skipped": "-", "manual": "○", "unknown": "?", "none": "-"}
CI_COL = {"success": "\033[32m", "failed": "\033[1;31m", "running": "\033[33m",
          "pending": "\033[2m"}


def ci_cache(job_id):
    p = os.path.join(HERE, "cache", f"ci-{job_id}.json")
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def ci_paint(text, status):
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"{CI_COL.get(status, '')}{text}\033[0m"


def ci_one_line(job_id):
    """Compact second line under a pr-open job: stages/jobs with status."""
    ci = ci_cache(job_id)
    if not ci:
        return None
    if ci.get("error") and not ci.get("jobs"):
        return f"  └ CI: error ({ci['error'][:80]})"
    jobs = ci.get("jobs") or []
    if not jobs:
        return f"  └ CI: pipeline={ci.get('pipeline', '-')}"
    # Group GitLab jobs by stage, keep GitHub checks flat
    stages = {}
    for jb in jobs:
        stages.setdefault(jb.get("stage") or "", []).append(jb)
    parts = []
    for stage, js in stages.items():
        prefix = f"{stage}:" if stage else ""
        cells = " ".join(ci_paint(f"{j['name']}{CI_SYM.get(j['status'], '?')}", j["status"])
                          for j in js[:12])
        parts.append(f"{prefix}{cells}" + ("…" if len(js) > 12 else ""))
    pipe = ci.get("pipeline", "-")
    line = f"  └ CI {pipe} │ " + " │ ".join(parts)
    if ci.get("stale_error"):
        line += " (stale)"
    return line


def ci_detail_lines(job_id):
    ci = ci_cache(job_id)
    if not ci:
        return ["no CI cache yet (run .factory/ci <job-id>)"]
    lines = [f"pipeline={ci.get('pipeline', '-')} merge={ci.get('merge', '-')}"
             + (f" at={ci.get('at', '-')}" if ci.get("at") else "")]
    if ci.get("url"):
        lines.append(ci["url"])
    if ci.get("error"):
        lines.append(f"error: {ci['error']}")
    for jb in ci.get("jobs", []):
        stage = f"[{jb.get('stage')}] " if jb.get("stage") else ""
        lines.append(f"  {CI_SYM.get(jb.get('status'), '?')} {jb.get('status', '-'):<8} "
                     f"{stage}{jb.get('name')}")
    if ci.get("stale_error"):
        lines.append(f"(stale: {ci['stale_error']})")
    return lines


def maybe_refresh_ci(no_ci):
    """Refresh stale CI caches; never blocks the board for long."""
    if no_ci:
        return
    ci = os.path.join(HERE, "ci")
    if not os.path.exists(ci):
        return
    try:
        subprocess.run([ci, "--quiet"], timeout=60,
                       capture_output=True, cwd=os.path.dirname(HERE))
    except Exception:
        pass

def render(jobs, no_ci=False):
    if not jobs:
        return "factory board: no jobs yet"
    sym = {"PASS": "✓", "CHANGES": "✗", None: "·"}
    lines = [header(jobs), f"{'JOB':<32} {'MODE':<5} {'STAGE':<12} {'RND':>3} {'PORT':>5}  {'REVIEWS':<38} UPDATED"]
    for j in jobs:
        revs = j.get("reviews") or {}
        r = " ".join(f"{k}{sym.get(v, '?')}" for k, v in revs.items()) or "-"
        lines.append(paint(f"{str(j['id'])[:32]:<32} {str(j.get('mode', '-')):<5} "
                           f"{str(j.get('stage', '-')):<12} "
                           f"{j.get('round', '-')!s:>3} {j.get('port', '-')!s:>5}  "
                           f"{r:<38} {age(j['updated']) if j.get('updated') else '-'}",
                           j.get("stage")))
        if not no_ci and j.get("stage") == "pr-open":
            sub = ci_one_line(j["id"])
            if sub:
                lines.append(sub)
    others = others_line() if not no_ci else None
    if others:
        lines += ["", others]
    return "\n".join(lines)


def others_line():
    """One footer line with recent non-factory pipelines (repo-wide CI)."""
    p = os.path.join(HERE, "cache", "ci-others.json")
    try:
        with open(p) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    pipes = data.get("pipelines") or []
    if not pipes:
        return None
    cells = []
    for pl in pipes[:5]:
        sym = CI_SYM.get(pl.get("status"), "?")
        cells.append(ci_paint(f"{pl.get('branch', '?')[:24]}{sym}", pl.get("status")))
    return "other CI: " + "  ".join(cells)

def main():
    jobs_dir = os.path.join(HERE, "jobs")
    no_ci = "--no-ci" in sys.argv
    if "--tmux" in sys.argv:
        if not os.environ.get("TMUX"):
            sys.exit("not inside tmux; just run .factory/watch")
        subprocess.run(["tmux", "split-window", "-v", "-l", "12", "-c", os.path.dirname(HERE),
                        os.path.abspath(__file__)])
        return
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if args:
        maybe_refresh_ci(no_ci)
        print(detail(jobs_dir, args[0]))
        return
    if "--once" in sys.argv:
        maybe_refresh_ci(no_ci)
        print(render(load(jobs_dir), no_ci))
        return
    try:
        while True:
            maybe_refresh_ci(no_ci)
            print("\033[2J\033[H" + render(load(jobs_dir), no_ci) + "\n\n(ctrl-c to stop)")
            time.sleep(2)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
